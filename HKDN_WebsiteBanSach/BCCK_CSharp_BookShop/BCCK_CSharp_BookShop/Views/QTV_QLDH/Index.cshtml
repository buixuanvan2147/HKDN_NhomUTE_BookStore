@model IEnumerable<BCCK_CSharp_BookShop.Models.DonHang>

@{
    ViewBag.Title = "Quản Lý Đơn Hàng";
    Layout = "~/Views/Shared/_LayoutQuanTriVien.cshtml";

    // Ép kiểu ViewBag.DoanhThuThongKe về đúng loại ViewModel để sử dụng Intellisense
    BCCK_CSharp_BookShop.ViewModel.QTV_DoanhThuViewModel thongKe = ViewBag.DoanhThuThongKe as BCCK_CSharp_BookShop.ViewModel.QTV_DoanhThuViewModel;
}

<style>
    /* Container chính cho toàn bộ nội dung */
    .order-list-container {
        padding: 60px 2vw 30px 2vw; /* Dùng vw để padding tự điều chỉnh */
        color: #E2E8F0;
        min-height: calc(100vh - 56px);
        box-sizing: border-box;
        background-color: #1A202C; /* Nền tối cho toàn bộ khu vực */
    }

    /* Tiêu đề trang */
    .page-title {
        text-align: center;
        font-size: clamp(1.8rem, 5vw, 2.2rem); /* Font size tự điều chỉnh */
        font-weight: 700;
        color: #4FD1C5; /* Màu xanh ngọc */
        margin-bottom: 30px;
        text-transform: uppercase;
        letter-spacing: 1.5px;
    }

    /* Container cho các thẻ thống kê */
    .stats-cards-container {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); /* Tự động chia cột */
        gap: 25px; /* Khoảng cách giữa các thẻ */
        margin-bottom: 50px; /* Khoảng cách với bảng bên dưới */
    }

    .stat-card {
        background-color: #2D3748; /* Màu nền thẻ thống kê */
        border-radius: 12px;
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.25);
        padding: 25px;
        text-align: center;
        border: 1px solid #4A5568; /* Viền nhẹ */
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .stat-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 12px 25px rgba(0, 0, 0, 0.35);
        }

        .stat-card h3 {
            font-size: clamp(1rem, 3vw, 1.3rem);
            color: #A0AEC0; /* Màu chữ tiêu đề thẻ */
            margin-bottom: 15px;
            font-weight: 600;
        }

        .stat-card .value {
            font-size: clamp(1.8rem, 4vw, 2.5rem);
            font-weight: 700;
            color: #4FD1C5; /* Màu chữ giá trị chính */
            margin-bottom: 10px;
        }

        .stat-card .sub-value {
            font-size: clamp(0.9rem, 2.5vw, 1.1rem);
            color: #E2E8F0; /* Màu chữ phụ */
            font-weight: 500;
        }

            .stat-card .sub-value .label {
                color: #A0AEC0;
                font-weight: 400;
                margin-right: 5px;
            }

    /* Nút "Tạo đơn hàng mới" */
    .add-new-button-container {
        text-align: right;
        margin-bottom: 25px;
    }

    .add-new-button {
        display: inline-flex;
        align-items: center;
        padding: 12px 25px;
        background: linear-gradient(45deg, #10B981, #059669);
        border: none;
        color: #ffffff;
        font-size: clamp(0.9rem, 2.5vw, 1rem);
        font-weight: 600;
        border-radius: 8px;
        cursor: pointer;
        transition: all 0.3s ease;
        box-shadow: 0 4px 10px rgba(16, 185, 129, 0.3);
        text-decoration: none;
    }

        .add-new-button:hover {
            background: linear-gradient(45deg, #059669, #10B981);
            transform: translateY(-3px);
            box-shadow: 0 6px 15px rgba(16, 185, 129, 0.4);
        }

        .add-new-button i {
            margin-right: 8px;
        }

    /* Bảng */
    .table-custom {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0;
        background-color: #2D3748;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
        color: #E2E8F0;
        margin-bottom: 70px;
        border: 1px solid #4A5568;
    }

        .table-custom thead {
            background-color: #1A202C;
            color: #4FD1C5;
            font-weight: 700;
            text-transform: uppercase;
            font-size: clamp(0.8rem, 2vw, 0.9rem);
            letter-spacing: 0.5px;
            white-space: nowrap;
        }

            .table-custom thead th {
                padding: 15px 1vw;
                text-align: left;
                border: 1px solid #4A5568;
            }

        .table-custom tbody tr {
            transition: background-color 0.2s ease;
        }

            .table-custom tbody tr:nth-child(even) {
                background-color: #262D3B;
            }

            .table-custom tbody tr:hover {
                background-color: #3D4A5E;
            }

        .table-custom tbody td {
            padding: 12px 1vw;
            border: 1px solid #4A5568;
            font-size: clamp(0.8rem, 2vw, 0.9rem);
            color: #E2E8F0;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

    /* Cột "Hành động" */
    .action-column {
        text-align: center;
        white-space: nowrap;
    }

    .action-buttons-group {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
    }

    .action-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 8px 12px;
        border-radius: 6px;
        text-decoration: none;
        font-size: clamp(0.75rem, 2vw, 0.85rem);
        font-weight: 600;
        transition: all 0.2s ease;
        box-shadow: 0 2px 5px rgba(0, 0, 0, 0.15);
        border: none;
        color: #ffffff;
    }

        .action-button i {
            margin-right: 5px;
        }

        .action-button.edit {
            background-color: #FCD34D;
            color: #1A202C;
        }

            .action-button.edit:hover {
                background-color: #FBBF24;
                transform: translateY(-2px);
                box-shadow: 0 3px 8px rgba(0, 0, 0, 0.2);
            }

        .action-button.details {
            background-color: #60A5FA;
        }

            .action-button.details:hover {
                background-color: #3B82F6;
                transform: translateY(-2px);
                box-shadow: 0 3px 8px rgba(0, 0, 0, 0.2);
            }

        .action-button.delete {
            background-color: #EF4444;
        }

            .action-button.delete:hover {
                background-color: #DC2626;
                transform: translateY(-2px);
                box-shadow: 0 3px 8px rgba(0, 0, 0, 0.2);
            }

    /* Responsive bằng cách sử dụng đơn vị tương đối và cuộn ngang */
    .table-responsive {
        overflow-x: auto; /* Thêm cuộn ngang khi cần */
        -webkit-overflow-scrolling: touch; /* Cải thiện cuộn trên mobile */
    }

    /* Media queries cho màn hình nhỏ hơn */
    @@media (max-width: 768px) {
        .order-list-container {
            padding: 40px 1vw 20px 1vw;
        }

        .page-title {
            font-size: 1.5rem;
            margin-bottom: 20px;
        }

        .stats-cards-container {
            grid-template-columns: 1fr; /* Một cột trên màn hình nhỏ */
            gap: 15px;
            margin-bottom: 30px;
        }

        .stat-card {
            padding: 20px;
        }

            .stat-card h3 {
                font-size: 1.1rem;
            }

            .stat-card .value {
                font-size: 2rem;
            }

            .stat-card .sub-value {
                font-size: 0.9rem;
            }

        .add-new-button {
            padding: 10px 20px;
            font-size: 0.9rem;
        }

        .table-custom thead th,
        .table-custom tbody td {
            padding: 10px 0.8vw;
            font-size: 0.85rem;
        }

        .action-button {
            padding: 6px 10px;
            font-size: 0.7rem;
        }

        .action-buttons-group {
            gap: 5px;
        }
    }
</style>

<div class="order-list-container">
    <h2 class="page-title">QUẢN LÝ ĐƠN HÀNG</h2>

    @if (thongKe != null)
    {
        <div class="stats-cards-container">
            <div class="stat-card">
                <h3>Đơn hàng đang xử lý</h3>
                <div class="value">@thongKe.SoLuongDonHangDangXuLy</div>
                <div class="sub-value"><span class="label">Tổng tiền:</span> @thongKe.TongTienDangXuLy.ToString("N0")₫</div>
            </div>

            <div class="stat-card">
                <h3>Đơn hàng đã giao</h3>
                <div class="value">@thongKe.SoLuongDonHangDaGiao</div>
                <div class="sub-value"><span class="label">Tổng tiền:</span> @thongKe.TongTienDaGiao.ToString("N0")₫</div>
            </div>

            <div class="stat-card">
                <h3>Đơn hàng đã hủy</h3>
                <div class="value">@thongKe.SoLuongDonHangDaHuy</div>
                <div class="sub-value"><span class="label">Tổng tiền:</span> @thongKe.TongTienDaHuy.ToString("N0")₫</div>
            </div>
        </div>
    }

    @* Bạn có thể bỏ comment phần này nếu bạn muốn hiển thị nút tạo đơn hàng mới *@
    @*<div class="add-new-button-container">
            <a href="@Url.Action("Create")" class="add-new-button">
                <i class="fas fa-plus-circle"></i> Tạo Đơn Hàng Mới
            </a>
        </div>*@

    <div class="table-responsive">
        <table class="table-custom">
            <thead>
                <tr>
                    <th>Khách Hàng</th>
                    <th>Địa Chỉ Giao</th>
                    <th>Ngày Tạo</th>
                    <th>Tổng Tiền</th>
                    <th>Trạng Thái</th>
                    <th>Hành động</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null)
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                @Html.DisplayFor(modelItem => item.NguoiDung.HoTen)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.DiaChiGiao)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.NgayTao)
                            </td>
                            <td>
                                @item.TongTien.ToString("N0")₫
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.TrangThaiDonHang)
                            </td>
                            <td class="action-column">
                                <div class="action-buttons-group">
                                    <a href="@Url.Action("Edit", new { id=item.MaDonHang })" class="action-button edit" title="Sửa">
                                        <i class="fas fa-edit"></i> Sửa
                                    </a>
                                    <a href="@Url.Action("Details", new { id=item.MaDonHang })" class="action-button details" title="Xem chi tiết">
                                        <i class="fas fa-eye"></i> Xem
                                    </a>
                                    <a href="@Url.Action("Delete", new { id=item.MaDonHang })" class="action-button delete" title="Xóa">
                                        <i class="fas fa-trash-alt"></i> Xóa
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" style="text-align: center; padding: 20px; color: #A0AEC0;">
                            Không có đơn hàng nào được tìm thấy.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    @* Đảm bảo Font Awesome đã được nhúng trong layout của bạn cho các icon *@
    @* Ví dụ: <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css"> *@
}