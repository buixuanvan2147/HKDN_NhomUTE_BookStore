
@{
    ViewBag.Title = "LienHe_Home";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    .contact-section {
        background-color: #f8f9fa; /* Nền nhẹ nhàng cho toàn bộ phần liên hệ */
        padding: 6rem 0; /* Tăng padding trên và dưới */
    }

    .contact-section .display-4 {
        color: #007bff; /* Màu primary của Bootstrap cho tiêu đề chính */
    }

    .contact-info-block,
    .contact-form-container {
        border: 1px solid #e9ecef; /* Viền nhẹ */
        box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.05); /* Đổ bóng nhẹ nhàng */
        height: 100%; /* Quan trọng để hai cột có chiều cao bằng nhau nếu nội dung chênh lệch */
        display: flex;
        flex-direction: column; /* Sử dụng flexbox để đẩy map xuống cuối */
    }

    .contact-info-block h3,
    .contact-form-container h3 {
        color: #343a40; /* Màu tối hơn cho tiêu đề trong các khối */
        font-weight: 600;
    }

    .contact-info-block .d-flex {
        align-items: flex-start; /* Căn chỉnh biểu tượng và văn bản ở đầu */
    }

    .contact-info-block .fa-2x {
        font-size: 1.8rem; /* Kích thước biểu tượng */
        color: #007bff; /* Màu primary cho biểu tượng */
    }

    .contact-info-block p {
        font-size: 0.95rem; /* Kích thước font cho thông tin */
        color: #6c757d; /* Màu xám cho văn bản */
    }

    .map-container {
        border-radius: 0.5rem; /* Bo tròn góc cho bản đồ */
        overflow: hidden; /* Đảm bảo nội dung iframe không tràn */
        width: 100%;
        flex-grow: 1; /* Cho phép map container giãn nở */
        display: flex; /* Để iframe được căn giữa */
        align-items: flex-end; /* Căn bản đồ xuống cuối nếu có khoảng trống */
    }

    .map-container iframe {
        width: 100%;
        height: 100%; /* Quan trọng để iframe lấp đầy container */
        min-height: 250px; /* Chiều cao tối thiểu cho bản đồ trên di động */
    }

    .contact-form-container .form-control {
        border-radius: 0.375rem; /* Bo tròn nhẹ input */
        padding: 0.8rem 1rem; /* Tăng padding cho input */
        border-color: #ced4da; /* Màu viền input */
    }

    .contact-form-container .form-control:focus {
        border-color: #80bdff; /* Màu viền khi focus */
        box-shadow: 0 0 0 0.25rem rgba(0, 123, 255, 0.25); /* Hiệu ứng shadow khi focus */
    }

    .contact-form-container .btn-primary {
        background-color: #007bff;
        border-color: #007bff;
        font-weight: bold;
        padding: 0.75rem 1.5rem;
        border-radius: 0.375rem;
        transition: background-color 0.3s ease;
    }

    .contact-form-container .btn-primary:hover {
        background-color: #0056b3;
        border-color: #0056b3;
    }

    /* Responsive adjustments */
    @@media (max-width: 991.98px) { /* Cho tablet và di động */
        .contact-info-block {
            margin-bottom: 2.5rem; /* Khoảng cách giữa 2 cột trên màn hình nhỏ */
        }
    }
</style>
<div class="container-fluid py-5 contact-section">
    <div class="container py-5">
        <div class="text-center mb-5">
            <h1 class="display-4 fw-bold text-primary">Liên Hệ Với Chúng Tôi</h1>
            <p class="lead text-muted">Chúng tôi luôn sẵn lòng lắng nghe và hỗ trợ bạn.</p>
        </div>

        <div class="row g-5 align-items-stretch">
            <div class="col-lg-5">
                <div class="bg-light p-4 rounded h-100 d-flex flex-column contact-info-block">
                    <h3 class="mb-4 text-dark">Thông Tin Liên Lạc</h3>
                    <div class="d-flex align-items-center mb-3">
                        <i class="fa fa-map-marker-alt fa-2x text-primary me-3"></i>
                        <div>
                            <h5 class="mb-0 text-dark">Địa Chỉ</h5>
                            <p class="mb-0 text-muted">48 Cao Thắng, Phường Thanh Bình, Quận Hải Châu, TP Đà Nẵng, Việt Nam</p>
                        </div>
                    </div>
                    <div class="d-flex align-items-center mb-3">
                        <i class="fa fa-envelope fa-2x text-primary me-3"></i>
                        <div>
                            <h5 class="mb-0 text-dark">Email</h5>
                            <p class="mb-0 text-muted">info@bookshop.com</p>
                        </div>
                    </div>
                    <div class="d-flex align-items-center mb-3">
                        <i class="fa fa-phone-alt fa-2x text-primary me-3"></i>
                        <div>
                            <h5 class="mb-0 text-dark">Điện Thoại</h5>
                            <p class="mb-0 text-muted">+012 345 67890</p>
                        </div>
                    </div>
                    <div class="d-flex align-items-center">
                        <i class="fa fa-clock fa-2x text-primary me-3"></i>
                        <div>
                            <h5 class="mb-0 text-dark">Giờ Làm Việc</h5>
                            <p class="mb-0 text-muted">Thứ 2 - Thứ 7: 8:00 AM - 6:00 PM</p>
                        </div>
                    </div>
                    <div class="mt-auto pt-4">
                        <h3 class="mb-3 text-dark">Vị trí của chúng tôi</h3>
                        <div class="map-container rounded overflow-hidden">
                            <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3833.779647079502!2d108.21102737490429!3d16.076920484603715!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x31421847f125d0a9%3A0x936779884318eeca!2zNDggQ2FvIFRo4bqvbmcsIFRoYW5oIELDrG5oLCBI4bqjaSBDaMOidSwgxJDDoCBO4bq1bmcgNTUwMDAwLCBWaeG7h3QgTmFt!5e0!3m2!1svi!2s!4v1747874534031!5m2!1svi!2s" width="100%" height="300" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
                        </div>
                    </div>
                </div>
            </div>

   
            <div class="col-lg-7">
                <div class="bg-light p-4 rounded h-100 contact-form-container">
                    <h3 class="mb-4 text-dark">Gửi Tin Nhắn Cho Chúng Tôi</h3>
                    <form action="#" method="post">
             
                        <div class="mb-3">
                            <input type="text" class="form-control" id="name" name="name" placeholder="Tên của bạn" required>
                        </div>
                        <div class="mb-3">
                            <input type="email" class="form-control" id="email" name="email" placeholder="Email của bạn" required>
                        </div>
                        <div class="mb-3">
                            <input type="text" class="form-control" id="subject" name="subject" placeholder="Tiêu đề" required>
                        </div>
                        <div class="mb-4">
                            <textarea class="form-control" id="message" name="message" rows="5" placeholder="Nội dung tin nhắn" required></textarea>
                        </div>
                        <button type="submit" class="btn btn-primary btn-lg w-100">Gửi Tin Nhắn</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

