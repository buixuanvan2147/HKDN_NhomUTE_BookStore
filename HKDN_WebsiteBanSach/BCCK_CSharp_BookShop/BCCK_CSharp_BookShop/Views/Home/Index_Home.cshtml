@model BCCK_CSharp_BookShop.ViewModel.Index_Home_ListSach
@{
    ViewBag.Title = "Index_Home";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    .book-card {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        height: 450px;
        display: flex;
        flex-direction: column;
        border: 1px solid #dee2e6;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        overflow: hidden;
        border-radius: 0.375rem !important;
    }

        .book-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.15);
            cursor: pointer;
        }

        .book-card .book-img {
            flex-grow: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 10px;
            overflow: hidden;
        }

            .book-card .book-img img {
                max-height: 100%;
                width: auto;
                object-fit: contain;
                border-radius: 0.375rem 0.375rem 0 0;
                cursor: pointer;
            }

        .book-card .book-info {
            height: 150px;
            background-color: #fff;
            padding: 1rem;
            border-top: none !important;
            border-radius: 0 0 0.375rem 0.375rem;
            box-shadow: 0 -2px 5px rgba(0, 0, 0, 0.05);
            z-index: 2;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

    .book-title {
        font-size: 1.1rem;
        color: #333;
        font-weight: 600;
        overflow: hidden;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
    }

    .carousel-item {
        height: 300px;
    }

        .carousel-item img {
            max-height: 100%;
            max-width: 100%;
            object-fit: contain;
        }
</style>

<!-- Hero Start -->
<div class="container-fluid py-5 mb-5 hero-header">
    <div class="container py-5">
        <div class="row g-5 align-items-center">
            <div class="col-md-12 col-lg-7">
                <h4 class="mb-3 text-secondary">Mua Sách Thả Ga</h4>
                <h1 class="mb-5 display-3 text-primary">
                    Giá kịch
                    sàn
                </h1>
                <div class="position-relative mx-auto">
                    <!-- Form tìm kiếm -->
                    <form action="@Url.Action("TimKiem", "Home")" method="get" class="d-flex">
                        <input class="form-control border-2 border-secondary w-75 py-3 px-4 rounded-pill"
                               type="text" name="tuKhoa" placeholder="Nhập từ khóa" value="@ViewBag.TuKhoa">
                        <button type="submit"
                                class="btn btn-primary border-2 border-secondary py-3 px-4 position-absolute rounded-pill text-white h-100"
                                style="top: 0; right: 25%;">
                            Tìm kiếm
                        </button>
                    </form>
                </div>
                <!-- Hiển thị thông báo tìm kiếm -->
                @if (!string.IsNullOrEmpty(ViewBag.TuKhoa))
                {
                    <p class="mt-3 text-success">Kết quả tìm kiếm cho: "<strong>@ViewBag.TuKhoa</strong>"</p>
                }
            </div>
            <div class="col-md-12 col-lg-5">
                <div id="carouselId" class="carousel slide position-relative" data-bs-ride="carousel">
                    <div class="carousel-inner" role="listbox">
                        <div class="carousel-item active rounded">
                            <img src="~/Content/images/nhaGiaKim.jpg" class="img-fluid w-100 h-100 bg-secondary rounded" alt="First slide">
                            <a href="#" class="btn px-4 py-2 text-white rounded">Tiểu Thuyết</a>
                        </div>
                        <div class="carousel-item rounded">
                            <img src="~/Content/images/luocSuThoiGian.jpg" class="img-fluid w-100 h-100 bg-secondary rounded" alt="Second slide">
                            <a href="#" class="btn px-4 py-2 text-white rounded">Khoa Học</a>
                        </div>
                        <div class="carousel-item rounded">
                            <img src="~/Content/images/dacNhanTam.jpg" class="img-fluid w-100 h-100 bg-secondary rounded" alt="Third slide">
                            <a href="#" class="btn px-4 py-2 text-white rounded text-center">
                                Tâm Lý<br />Kỹ Năng Sống
                            </a>
                        </div>
                        <div class="carousel-item rounded">
                            <img src="~/Content/images/lichSuVietNam.jpg" class="img-fluid w-100 h-100 bg-light rounded" alt="Fifth slide">
                            <a href="#" class="btn px-4 py-2 text-white rounded">Lịch Sử</a>
                        </div>
                        <div class="carousel-item rounded">
                            <img src="~/Content/images/thienDuongMuaHe.jpg" class="img-fluid w-100 h-100 bg-light rounded" alt="Sixth slide">
                            <a href="#" class="btn px-4 py-2 text-white rounded">Tiểu Thuyết</a>
                        </div>
                    </div>
                    <button class="carousel-control-prev" type="button" data-bs-target="#carouselId" data-bs-slide="prev">
                        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">Previous</span>
                    </button>
                    <button class="carousel-control-next" type="button" data-bs-target="#carouselId" data-bs-slide="next">
                        <span class="carousel-control-next-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">Next</span>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Hero End -->

<!-- Featurs Section Start -->
<div class="container-fluid featurs py-5">
    <div class="container py-5">
        <div class="row g-4">
            <div class="col-md-6 col-lg-3">
                <div class="featurs-item text-center rounded bg-light p-4">
                    <div class="featurs-icon btn-square rounded-circle bg-secondary mb-5 mx-auto">
                        <i class="fas fa-car-side fa-3x text-white"></i>
                    </div>
                    <div class="featurs-content text-center">
                        <h5>Miễn phí vận chuyển</h5>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="featurs-item text-center rounded bg-light p-4">
                    <div class="featurs-icon btn-square rounded-circle bg-secondary mb-5 mx-auto">
                        <i class="fas fa-user-shield fa-3x text-white"></i>
                    </div>
                    <div class="featurs-content text-center">
                        <h5>Thanh toán an toàn</h5>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="featurs-item text-center rounded bg-light p-4">
                    <div class="featurs-icon btn-square rounded-circle bg-secondary mb-5 mx-auto">
                        <i class="fas fa-exchange-alt fa-3x text-white"></i>
                    </div>
                    <div class="featurs-content text-center">
                        <h5>30 ngày trả hàng</h5>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="featurs-item text-center rounded bg-light p-4">
                    <div class="featurs-icon btn-square rounded-circle bg-secondary mb-5 mx-auto">
                        <i class="fa fa-phone-alt fa-3x text-white"></i>
                    </div>
                    <div class="featurs-content text-center">
                        <h5>Hỗ trợ 24/7</h5>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Featurs Section End -->

<!-- Fruits Shop Start -->
<div class="container-fluid fruite py-5" style="background-color: #ffffff;">
    <div class="container py-5">
        <div class="tab-class text-center">
            <div class="row g-4">
                <div class="col-lg-4 text-start">
                    <h1>Xu hướng mua sắm</h1>
                </div>
                <div class="col-lg-8 text-end">
                    <ul class="nav nav-pills d-inline-flex text-center mb-5">
                        <li class="nav-item">
                            <a class="d-flex m-2 py-2 bg-light rounded-pill active" data-bs-toggle="pill" href="#tab-1">
                                <span class="text-dark" style="width: 130px;">Tất cả sản phẩm</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="d-flex py-2 m-2 bg-light rounded-pill" data-bs-toggle="pill" href="#tab-2">
                                <span class="text-dark" style="width: 170px;">Sách Hot</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="d-flex py-2 m-2 bg-light rounded-pill" data-bs-toggle="pill" href="#tab-3">
                                <span class="text-dark" style="width: 150px;">Xu hướng</span>
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
            <div class="tab-content">
                <!-- Tab Tất cả sản phẩm -->
                <div id="tab-1" class="tab-pane fade show p-0 active">
                    <div class="row g-4">
                        <div class="col-lg-12">
                            <div class="row g-4">
                                @if (Model.TatCaSach != null && Model.TatCaSach.Any())
                                {
                                    foreach (var item1 in Model.TatCaSach) // Loại bỏ @
                                    {
                                        <div class="col-md-6 col-lg-4 col-xl-3">
                                            <div class="book-card position-relative">
                                                <div class="book-img">
                                                    <img src="~/Content/images/@item1.URLAnhBia" class="img-fluid w-100 rounded-top book-image" data-masach="@item1.MaSach" alt="@item1.TenSach" />
                                                </div>
                                                <div class="text-white bg-secondary px-3 py-1 rounded position-absolute" style="top: 10px; left: 10px; z-index: 10; font-weight: bold;">
                                                    Tồn kho: @item1.SoLuongTon
                                                </div>
                                                <div class="book-info border border-secondary border-top-0">
                                                    <h4 class="book-title">@item1.TenSach</h4>
                                                    <div class="d-flex justify-content-between flex-wrap align-items-end mt-2">
                                                        <p class="text-dark fs-5 fw-bold mb-0">@item1.Gia.ToString("N0") đồng</p>
                                                        <button class="btn border border-secondary rounded-pill px-3 text-primary add-to-cart" data-masach="@item1.MaSach" style="font-size: 0.9rem; padding: 0.5rem 1rem;">
                                                            <i class="fa fa-shopping-bag me-2 text-primary"></i>
                                                            Add to cart
                                                        </button>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <div class="col-12 text-center">
                                        <p class="text-danger">Không tìm thấy sản phẩm nào phù hợp với từ khóa "@ViewBag.TuKhoa".</p>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
                <!-- Tab Sách Hot -->
                <div id="tab-2" class="tab-pane fade show p-0">
                    <div class="row g-4">
                        <div class="col-lg-12">
                            <div class="row g-4">
                                @if (Model.SachHot != null && Model.SachHot.Any())
                                {
                                    foreach (var item2 in Model.SachHot) // Loại bỏ @
                                    {
                                        <div class="col-md-6 col-lg-4 col-xl-3">
                                            <div class="book-card position-relative">
                                                <div class="book-img">
                                                    <img src="~/Content/images/@item2.URLAnhBia" class="img-fluid w-100 rounded-top book-image" data-masach="@item2.MaSach" alt="@item2.TenSach" />
                                                </div>
                                                <div class="text-white bg-secondary px-3 py-1 rounded position-absolute" style="top: 10px; left: 10px; z-index: 10; font-weight: bold;">
                                                    Sách Hot
                                                </div>
                                                <div class="book-info border border-secondary border-top-0">
                                                    <h4 class="book-title">@item2.TenSach</h4>
                                                    <div class="d-flex justify-content-between flex-wrap align-items-end mt-2">
                                                        <p class="text-dark fs-5 fw-bold mb-0">@item2.Gia.ToString("N0") đồng</p>
                                                        <button class="btn border border-secondary rounded-pill px-3 text-primary add-to-cart" data-masach="@item2.MaSach" style="font-size: 0.9rem; padding: 0.5rem 1rem;">
                                                            <i class="fa fa-shopping-bag me-2 text-primary"></i>
                                                            Add to cart
                                                        </button>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <div class="col-12 text-center">
                                        <p class="text-danger">Không tìm thấy sách hot nào phù hợp với từ khóa "@ViewBag.TuKhoa".</p>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
                <!-- Tab Xu hướng -->
                <div id="tab-3" class="tab-pane fade show p-0">
                    <div class="row g-4">
                        <div class="col-lg-12">
                            <div class="row g-4">
                                @if (Model.SachXuHuong != null && Model.SachXuHuong.Any())
                                {
                                    foreach (var item3 in Model.SachXuHuong) // Loại bỏ @
                                    {
                                        <div class="col-md-6 col-lg-4 col-xl-3">
                                            <div class="book-card position-relative">
                                                <div class="book-img">
                                                    <img src="~/Content/images/@item3.URLAnhBia" class="img-fluid w-100 rounded-top book-image" data-masach="@item3.MaSach" alt="@item3.TenSach" />
                                                </div>
                                                <div class="text-white bg-secondary px-3 py-1 rounded position-absolute" style="top: 10px; left: 10px; z-index: 10; font-weight: bold;">
                                                    Xu hướng
                                                </div>
                                                <div class="book-info border border-secondary border-top-0">
                                                    <h4 class="book-title">@item3.TenSach</h4>
                                                    <div class="d-flex justify-content-between flex-wrap align-items-end mt-2">
                                                        <p class="text-dark fs-5 fw-bold mb-0">@item3.Gia.ToString("N0") đồng</p>
                                                        <button class="btn border border-secondary rounded-pill px-3 text-primary add-to-cart" data-masach="@item3.MaSach" style="font-size: 0.9rem; padding: 0.5rem 1rem;">
                                                            <i class="fa fa-shopping-bag me-2 text-primary"></i>
                                                            Add to cart
                                                        </button>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <div class="col-12 text-center">
                                        <p class="text-danger">Không tìm thấy sách xu hướng nào phù hợp với từ khóa "@ViewBag.TuKhoa".</p>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Books Shop End -->
