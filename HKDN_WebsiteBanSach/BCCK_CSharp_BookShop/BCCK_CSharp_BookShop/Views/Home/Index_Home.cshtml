<!-- Thêm Bootstrap Modal -->
<div class="modal fade" id="cartModal" tabindex="-1" aria-labelledby="cartModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="cartModalLabel">Thông báo</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                Thêm thành công vào giỏ hàng!
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" data-bs-dismiss="modal" id="okButton">OK</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Xử lý sự kiện click vào ảnh sách
            $(".book-image").click(function () {
                var maSach = $(this).data("masach");
                window.location.href = '@Url.Action("ChiTietSach", "Home")' + '?maSach=' + maSach;
            });

            // Xử lý sự kiện click vào nút "Add to cart"
            $(".add-to-cart").click(function () {
                var maSach = $(this).data("masach");
                $.ajax({
                    url: '@Url.Action("KiemTraDangNhap", "KhachHang")',
                    type: 'POST',
                    success: function (response) {
                        if (response.loggedIn) {
                            $.ajax({
                                url: '@Url.Action("ThemVaoGioHang", "KhachHang")',
                                type: 'POST',
                                data: { maSach: maSach },
                                success: function (response) {
                                    if (response.success) {
                                        $("#cartModal").modal('show');
                                    } else {
                                        alert(response.message);
                                    }
                                },
                                error: function () {
                                    alert("Đã có lỗi xảy ra khi thêm vào giỏ hàng.");
                                }
                            });
                        } else {
                            window.location.href = '@Url.Action("DangNhap", "Home")';
                        }
                    },
                    error: function () {
                        alert("Đã có lỗi xảy ra khi kiểm tra đăng nhập.");
                    }
                });
            });

            // Xử lý nút OK trong modal
            $("#okButton").click(function () {
                window.location.href = '@Url.Action("Index_Home", "Home")';
            });
        });
    </script>
}