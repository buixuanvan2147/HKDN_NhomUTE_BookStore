@model HKDN_GroupUTE_BookStore.ViewModel.Index_Home_ListSach
@{
    ViewBag.Title = "Trang Chủ - Nhà Sách UTE";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    /* --- 0. BIẾN MÀU SẮC CHUNG --- */
    :root {
        --primary-color: #0F9D58; /* Xanh chủ đạo */
        --primary-hover: #0B8043; /* Xanh đậm khi hover */
        --bg-soft-mint: #f2fbf7; /* Nền xanh rất nhạt cho sự liền mạch */
        --text-dark: #333;
        --text-grey: #666;
    }

    /* --- 1. HERO SECTION & TÌM KIẾM --- */
    .hero-search-section {
        /* Gradient xanh mát mắt */
        background: linear-gradient(135deg, rgba(204, 251, 241, 0.95) 0%, rgba(224, 242, 254, 0.95) 100%);
        position: relative;
        padding: 60px 0 150px 0; /* Padding dưới lớn để chứa wave */
        overflow: hidden;
    }

    /* Form tìm kiếm */
    .search-box-modern {
        background: #fff;
        border-radius: 50px;
        padding: 5px 5px 5px 25px;
        box-shadow: 0 10px 30px rgba(15, 157, 88, 0.15);
        display: flex;
        align-items: center;
        width: 100%;
        border: 1px solid rgba(255,255,255,0.8);
        transition: all 0.3s ease;
    }

        .search-box-modern:focus-within {
            transform: translateY(-3px);
            box-shadow: 0 15px 35px rgba(15, 157, 88, 0.2);
            border-color: var(--primary-color);
        }

    .search-input-modern {
        border: none;
        outline: none;
        background: transparent;
        font-size: 1rem;
        color: #555;
        flex-grow: 1;
        height: 45px;
    }

    .search-btn-modern {
        white-space: nowrap;
        border-radius: 40px;
        padding: 0 35px;
        height: 45px;
        font-weight: 600;
        background: var(--primary-color); /* Dùng màu chủ đạo */
        border: none;
        color: white;
        box-shadow: 0 4px 15px rgba(15, 157, 88, 0.3);
        transition: all 0.3s;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .search-btn-modern:hover {
            background: var(--primary-hover);
            transform: scale(1.05);
            box-shadow: 0 6px 20px rgba(15, 157, 88, 0.4);
        }

    /* Wave nối Hero và Book Section */
    .wave-hero-bottom {
        position: absolute;
        bottom: 0;
        left: 0;
        width: 100%;
        overflow: hidden;
        line-height: 0;
    }

        .wave-hero-bottom svg {
            position: relative;
            display: block;
            width: calc(130% + 1.3px);
            height: 100px;
        }
        /* QUAN TRỌNG: Fill màu trùng với nền của section Kệ sách bên dưới */
        .wave-hero-bottom .shape-fill {
            fill: var(--bg-soft-mint);
        }

    /* --- 2. BOOK SECTION (KỆ SÁCH) --- */
    .book-section-wrapper {
        background-color: var(--bg-soft-mint); /* Nền xanh nhạt nối tiếp */
        padding-top: 20px;
        padding-bottom: 100px; /* Chừa chỗ cho wave dưới */
        position: relative;
    }

    .book-card {
        border: none;
        border-radius: 15px !important;
        background: #fff;
        transition: all 0.3s ease;
        overflow: hidden;
        height: 100%;
        display: flex;
        flex-direction: column;
        box-shadow: 0 5px 15px rgba(0,0,0,0.05);
    }

        .book-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 15px 30px rgba(15, 157, 88, 0.15);
        }

    .book-img {
        height: 240px;
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 15px;
        background: #fff;
        position: relative;
    }

        .book-img img {
            max-height: 100%;
            max-width: 100%;
            object-fit: contain;
            transition: transform 0.3s;
            cursor: pointer;
            filter: drop-shadow(0 5px 5px rgba(0,0,0,0.1));
        }

    .book-card:hover .book-img img {
        transform: scale(1.08);
    }

    /* Badge Kho (Đã thêm lại) */
    .badge-stock {
        position: absolute;
        top: 10px;
        left: 10px;
        background: rgba(51, 51, 51, 0.8);
        color: #fff;
        padding: 4px 10px;
        border-radius: 8px;
        font-size: 0.75rem;
        font-weight: 600;
        z-index: 5;
        backdrop-filter: blur(2px);
    }

    .badge-hot {
        position: absolute;
        top: 10px;
        right: 10px;
        background: #ff4757;
        color: white;
        padding: 4px 10px;
        border-radius: 8px;
        font-size: 0.75rem;
        font-weight: 700;
        z-index: 5;
        box-shadow: 0 2px 5px rgba(255, 71, 87, 0.3);
    }

    .book-info {
        padding: 15px 20px 20px 20px;
        flex-grow: 1;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        background: #fff;
    }

    .book-title {
        font-size: 1.05rem;
        font-weight: 700;
        margin-bottom: 10px;
        color: var(--text-dark);
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        height: 2.5em;
        line-height: 1.25;
    }

    /* Nút thêm giỏ hàng (Đã chỉnh màu) */
    .btn-add-cart {
        background-color: var(--primary-color);
        color: white;
        border: none;
        border-radius: 50px;
        padding: 8px 15px;
        font-weight: 600;
        width: 100%;
        transition: all 0.3s;
        box-shadow: 0 4px 10px rgba(15, 157, 88, 0.2);
    }

        .btn-add-cart:hover {
            background-color: var(--primary-hover);
            color: white;
            transform: translateY(-2px);
            box-shadow: 0 6px 15px rgba(15, 157, 88, 0.3);
        }

    /* Tab navigation style */
    .nav-pills .nav-link.active, .nav-pills .show > .nav-link {
        background-color: var(--primary-color);
        box-shadow: 0 4px 10px rgba(15, 157, 88, 0.3);
    }

    .nav-pills .nav-link {
        color: var(--text-dark);
        background: #fff;
        margin: 0 5px;
        transition: all 0.3s;
    }

    /* Wave cuối Book Section */
    .wave-book-bottom {
        position: absolute;
        bottom: 0;
        left: 0;
        width: 100%;
        overflow: hidden;
        line-height: 0;
        transform: rotate(180deg); /* Lật ngược để tạo hiệu ứng kết thúc */
    }

        .wave-book-bottom svg {
            position: relative;
            display: block;
            width: calc(130% + 1.3px);
            height: 80px;
        }

        .wave-book-bottom .shape-fill {
            fill: #FFFFFF; /* Chuyển về màu trắng cho section thống kê */
        }

    /* --- 3. STATS & TESTIMONIALS --- */
    .stats-section {
        background: #fff;
        padding: 60px 0;
    }

    .stat-item {
        padding: 20px;
        text-align: center;
    }

    .stat-icon {
        width: 80px;
        height: 80px;
        background: rgba(15, 157, 88, 0.1);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 15px;
        color: var(--primary-color);
        font-size: 2rem;
    }

    .stat-number {
        display: block;
        font-size: 2rem;
        font-weight: 800;
        color: #333;
    }

    .testimonial-section {
        background-color: var(--bg-soft-mint);
        padding: 80px 0;
        position: relative;
    }

    .testimonial-card {
        background: #fff;
        padding: 30px;
        border-radius: 20px;
        box-shadow: 0 5px 20px rgba(0,0,0,0.05);
        height: 100%;
        transition: transform 0.3s;
    }

        .testimonial-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 30px rgba(15, 157, 88, 0.1);
        }
</style>

<div class="hero-search-section">
    <div style="position: absolute; width: 300px; height: 300px; background: rgba(255, 255, 255, 0.2); border-radius: 50%; top: -100px; left: -50px;"></div>
    <div style="position: absolute; width: 200px; height: 200px; background: rgba(255, 255, 255, 0.2); border-radius: 50%; bottom: 50px; right: 10%;"></div>

    <div class="container position-relative" style="z-index: 2;">
        <div class="row justify-content-center text-center">
            <div class="col-lg-8">
                <h4 class="text-primary fw-bold text-uppercase mb-2" style="letter-spacing: 2px; font-size: 0.9rem;">Thư viện tri thức</h4>
                <h1 class="display-5 fw-bold text-dark mb-4">
                    Tìm cuốn sách <span class="text-primary position-relative">yêu thích</span> của bạn
                </h1>

                <div class="position-relative mx-auto mt-5" style="max-width: 650px;">
                    <form action="@Url.Action("TimKiem", "Home")" method="get" class="w-100">
                        <div class="search-box-modern">
                            <i class="fas fa-search text-secondary fs-5 me-2"></i>
                            <input class="search-input-modern"
                                   type="text" name="tuKhoa" placeholder="Nhập tên sách, tác giả..." value="@ViewBag.TuKhoa">

                            <button type="submit" class="search-btn-modern">
                                Tìm kiếm
                            </button>
                        </div>
                    </form>
                </div>

                @if (!string.IsNullOrEmpty(ViewBag.TuKhoa))
                {
                    <div class="mt-4 animate__animated animate__fadeInUp">
                        <div class="d-inline-block bg-white px-4 py-2 rounded-pill shadow-sm border border-light">
                            <span class="text-secondary me-2">Kết quả cho:</span>
                            <span class="text-primary fw-bold fs-5">"@ViewBag.TuKhoa"</span>
                            <a href="@Url.Action("Index_Home", "Home")" class="ms-3 text-danger text-decoration-none small">
                                <i class="fas fa-times-circle"></i> Xóa
                            </a>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="wave-hero-bottom">
        <svg data-name="Layer 1" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 120" preserveAspectRatio="none">
            <path d="M321.39,56.44c58-10.79,114.16-30.13,172-41.86,82.39-16.72,168.19-17.73,250.45-.39C823.78,31,906.67,72,985.66,92.83c70.05,18.48,146.53,26.09,214.34,3V0H0V27.35A600.21,600.21,0,0,0,321.39,56.44Z" class="shape-fill"></path>
        </svg>
    </div>
</div>

<div class="book-section-wrapper">
    <div class="container">
        <div class="tab-class text-center">
            <div class="row g-4 align-items-center mb-5">
                <div class="col-lg-4 text-start">
                    <h2 class="text-dark fw-bold mb-0">Kệ sách Online</h2>
                </div>
                <div class="col-lg-8 text-end">
                    <ul class="nav nav-pills d-inline-flex text-center">
                        <li class="nav-item">
                            <a class="d-flex m-2 py-2 px-4 rounded-pill active" data-bs-toggle="pill" href="#tab-1">
                                <span class="fw-bold">Tất cả</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="d-flex py-2 px-4 m-2 rounded-pill" data-bs-toggle="pill" href="#tab-2">
                                <span class="fw-bold">Sách Hot</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="d-flex py-2 px-4 m-2 rounded-pill" data-bs-toggle="pill" href="#tab-3">
                                <span class="fw-bold">Xu hướng</span>
                            </a>
                        </li>
                    </ul>
                </div>
            </div>

            <div class="tab-content">
                <div id="tab-1" class="tab-pane fade show p-0 active">
                    <div class="row g-4">
                        @if (Model.TatCaSach != null && Model.TatCaSach.Any())
                        {
                            foreach (var item in Model.TatCaSach)
                            {
                                <div class="col-6 col-md-4 col-lg-3">
                                    <div class="book-card">
                                        <div class="book-img">
                                            <img src="~/images/@item.UrlanhBia" class="book-image" data-masach="@item.MaSach" alt="@item.TenSach" />
                                            <div class="badge-stock">Kho: @item.SoLuongTon</div>
                                            @if (item.SoLuongTon > 0 && item.SoLuongTon < 10)
                                            {
                                                <div class="badge-hot" style="background:#f39c12; right:auto; left:10px; top:35px;">Sắp hết</div>
                                            }
                                        </div>
                                        <div class="book-info">
                                            <h4 class="book-title" title="@item.TenSach">@item.TenSach</h4>
                                            <div class="mt-auto">
                                                <div class="d-flex justify-content-between align-items-center mb-3">
                                                    <span class="text-primary fs-5 fw-bold">Giá bán: @item.Gia.ToString("N0") đ</span>
                                                </div>
                                                <button class="btn-add-cart add-to-cart" data-masach="@item.MaSach">
                                                    <i class="fa fa-shopping-bag me-2"></i> Thêm vào giỏ hàng
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {

                            <div class="col-12 py-5 text-muted">Không có sách nào.</div>
                        }
                    </div>
                </div>

                <div id="tab-2" class="tab-pane fade show p-0">
                    <div class="row g-4">
                        @if (Model.SachHot != null && Model.SachHot.Any())
                        {
                            foreach (var item in Model.SachHot)
                            {
                                <div class="col-6 col-md-4 col-lg-3">
                                    <div class="book-card">
                                        <div class="book-img">
                                            <img src="~/images/@item.UrlanhBia" class="book-image" data-masach="@item.MaSach" alt="@item.TenSach" />
                                            <div class="badge-stock">Kho: @item.SoLuongTon</div>
                                            <div class="badge-hot">HOT</div>
                                        </div>
                                        <div class="book-info">
                                            <h4 class="book-title" title="@item.TenSach">@item.TenSach</h4>
                                            <div class="mt-auto">
                                                <div class="d-flex justify-content-between align-items-center mb-3">
                                                    <span class="text-primary fs-5 fw-bold">Giá bán: @item.Gia.ToString("N0") đ</span>
                                                </div>
                                                <button class="btn-add-cart add-to-cart" data-masach="@item.MaSach">
                                                    <i class="fa fa-shopping-bag me-2"></i> Thêm vào giỏ hàng
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                </div>

                <div id="tab-3" class="tab-pane fade show p-0">
                    <div class="row g-4">
                        @if (Model.SachXuHuong != null && Model.SachXuHuong.Any())
                        {
                            foreach (var item in Model.SachXuHuong)
                            {
                                <div class="col-6 col-md-4 col-lg-3">
                                    <div class="book-card">
                                        <div class="book-img">
                                            <img src="~/images/@item.UrlanhBia" class="book-image" data-masach="@item.MaSach" alt="@item.TenSach" />
                                            <div class="badge-stock">Kho: @item.SoLuongTon</div>
                                            <div class="badge-hot" style="background: #0984e3;">Xu hướng</div>
                                        </div>
                                        <div class="book-info">
                                            <h4 class="book-title" title="@item.TenSach">@item.TenSach</h4>
                                            <div class="mt-auto">
                                                <div class="d-flex justify-content-between align-items-center mb-3">
                                                    <span class="text-primary fs-5 fw-bold">Giá bán: @item.Gia.ToString("N0") đ</span>
                                                </div>
                                                <button class="btn-add-cart add-to-cart" data-masach="@item.MaSach">
                                                    <i class="fa fa-shopping-bag me-2"></i> Thêm vào giỏ hàng
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="wave-book-bottom">
        <svg data-name="Layer 1" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 120" preserveAspectRatio="none">
            <path d="M321.39,56.44c58-10.79,114.16-30.13,172-41.86,82.39-16.72,168.19-17.73,250.45-.39C823.78,31,906.67,72,985.66,92.83c70.05,18.48,146.53,26.09,214.34,3V0H0V27.35A600.21,600.21,0,0,0,321.39,56.44Z" class="shape-fill"></path>
        </svg>
    </div>
</div>

<div class="stats-section">
    <div class="container">
        <div class="row g-4">
            <div class="col-6 col-md-3">
                <div class="stat-item">
                    <div class="stat-icon"><i class="fas fa-users"></i></div>
                    <span class="stat-number">1,963</span>
                    <span class="stat-label">Khách hàng</span>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="stat-item">
                    <div class="stat-icon"><i class="fas fa-smile"></i></div>
                    <span class="stat-number">99%</span>
                    <span class="stat-label">Hài lòng</span>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="stat-item">
                    <div class="stat-icon"><i class="fas fa-certificate"></i></div>
                    <span class="stat-number">33</span>
                    <span class="stat-label">Chứng nhận</span>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="stat-item">
                    <div class="stat-icon"><i class="fas fa-book-open"></i></div>
                    <span class="stat-number">789</span>
                    <span class="stat-label">Sách bán chạy</span>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="testimonial-section">
    <div class="custom-shape-divider-top" style="position: absolute; top: 0; left: 0; width: 100%; overflow: hidden; line-height: 0;">
        <svg data-name="Layer 1" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 120" preserveAspectRatio="none" style="position: relative; display: block; width: calc(130% + 1.3px); height: 50px;">
            <path d="M985.66,92.83C906.67,72,823.78,31,743.84,14.19c-82.26-17.34-168.06-16.33-250.45.39-57.84,11.73-114,31.07-172,41.86A600.21,600.21,0,0,1,0,27.35V120H1200V95.8C1132.19,118.92,1055.71,111.31,985.66,92.83Z" fill="#FFFFFF"></path>
        </svg>
    </div>

    <div class="container position-relative z-2">
        <div class="text-center mb-5">
            <h4 class="text-primary fw-bold text-uppercase">Đánh giá</h4>
            <h1 class="display-6 fw-bold text-dark">Khách hàng nói gì về chúng tôi!</h1>
        </div>

        <div class="row g-4">
            <div class="col-md-4">
                <div class="testimonial-card">
                    <div style="font-size: 4rem; color: rgba(15, 157, 88, 0.1); position: absolute; top: 20px; left: 20px; font-family: serif; line-height: 1;">“</div>
                    <p class="mb-4 mt-4" style="position:relative; z-index:2; font-style:italic; color:#555;">Sách được đóng gói rất cẩn thận, giao đến tay vẫn như mới. Rất hài lòng về cách phục vụ!</p>
                    <div style="display: flex; align-items: center; border-top: 1px solid #eee; padding-top: 15px;">
                        <img src="~/images/index_Home_defaultUser1.jpg" style="width: 50px; height: 50px; border-radius: 50%; object-fit: cover; margin-right: 15px; border: 2px solid var(--primary-color);" alt="User">
                        <div>
                            <h6 class="m-0 fw-bold">Bùi Xuân Văn</h6>
                            <small class="text-muted">Sinh viên</small>
                            <div class="text-warning small"><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i></div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="testimonial-card">
                    <div style="font-size: 4rem; color: rgba(15, 157, 88, 0.1); position: absolute; top: 20px; left: 20px; font-family: serif; line-height: 1;">“</div>
                    <p class="mb-4 mt-4" style="position:relative; z-index:2; font-style:italic; color:#555;">Giá cả hợp lý, hay có khuyến mãi. Sẽ tiếp tục ủng hộ nhà sách dài dài.</p>
                    <div style="display: flex; align-items: center; border-top: 1px solid #eee; padding-top: 15px;">
                        <img src="~/images/index_Home_defaultUser2.jpg" style="width: 50px; height: 50px; border-radius: 50%; object-fit: cover; margin-right: 15px; border: 2px solid var(--primary-color);" alt="User">
                        <div>
                            <h6 class="m-0 fw-bold">Nguyễn Văn Viên</h6>
                            <small class="text-muted">Kỹ sư</small>
                            <div class="text-warning small"><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i></div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="testimonial-card">
                    <div style="font-size: 4rem; color: rgba(15, 157, 88, 0.1); position: absolute; top: 20px; left: 20px; font-family: serif; line-height: 1;">“</div>
                    <p class="mb-4 mt-4" style="position:relative; z-index:2; font-style:italic; color:#555;">Nhân viên tư vấn nhiệt tình, giao hàng siêu tốc. 10 điểm cho chất lượng!</p>
                    <div style="display: flex; align-items: center; border-top: 1px solid #eee; padding-top: 15px;">
                        <img src="~/images/index_Home_defaultUser3.png" style="width: 50px; height: 50px; border-radius: 50%; object-fit: cover; margin-right: 15px; border: 2px solid var(--primary-color);" alt="User">
                        <div>
                            <h6 class="m-0 fw-bold">Nguyễn Công Trung</h6>
                            <small class="text-muted">Giảng viên</small>
                            <div class="text-warning small"><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star-half-alt"></i></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="cartModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title"><i class="fas fa-check-circle me-2"></i>Thành công</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-center py-4">
                <h5 class="text-dark">Đã thêm sản phẩm vào giỏ hàng!</h5>
            </div>
            <div class="modal-footer justify-content-center">
                <button type="button" class="btn btn-success px-4 rounded-pill" data-bs-dismiss="modal" id="okButton">Tiếp tục mua sắm</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Click ảnh vào chi tiết
            $(".book-image").click(function () {
                var maSach = $(this).data("masach");
                window.location.href = '@Url.Action("ChiTietSach", "Home")' + '?maSach=' + maSach;
            });

            // Logic thêm giỏ hàng
            $(".add-to-cart").click(function () {
                var maSach = $(this).data("masach");
                var btn = $(this);
                var originalHtml = btn.html(); // Lưu nội dung cũ để restore

                // Hiệu ứng loading
                btn.html('<i class="fas fa-spinner fa-spin"></i> Đang xử lý...').prop('disabled', true);

                $.ajax({
                    url: '@Url.Action("KiemTraDangNhap", "KhachHang")',
                    type: 'POST',
                    success: function (response) {
                        if (response.loggedIn) {
                            $.ajax({
                                url: '@Url.Action("ThemVaoGioHang", "KhachHang")',
                                type: 'POST',
                                data: { maSach: maSach },
                                success: function (response) {
                                    if (response.success) {
                                        $("#cartModal").modal('show');
                                    } else {
                                        alert(response.message);
                                    }
                                    // Reset nút
                                    btn.html(originalHtml).prop('disabled', false);
                                },
                                error: function () {
                                    alert("Lỗi thêm giỏ hàng.");
                                    btn.html(originalHtml).prop('disabled', false);
                                }
                            });
                        } else {
                            window.location.href = '@Url.Action("DangNhap", "Home")';
                        }
                    },
                    error: function () {
                        alert("Lỗi kiểm tra đăng nhập.");
                        btn.html(originalHtml).prop('disabled', false);
                    }
                });
            });
        });
    </script>
}