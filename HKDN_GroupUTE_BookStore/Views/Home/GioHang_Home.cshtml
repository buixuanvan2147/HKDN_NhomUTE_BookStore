@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
@{
    ViewBag.Title = "Giỏ Hàng";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    /* --- BIẾN MÀU SẮC & STYLE CHUNG --- */
    :root {
        --primary-color: #0F9D58;
        --primary-hover: #0B8043;
        --bg-soft-mint: #f2fbf7;
        --text-dark: #333;
    }

    body {
        background-color: var(--bg-soft-mint);
    }

    /* --- HEADER VỚI WAVE --- */
    .page-header-wave {
        background: linear-gradient(135deg, rgba(204, 251, 241, 0.95) 0%, rgba(224, 242, 254, 0.95) 100%);
        padding: 60px 0 100px 0;
        position: relative;
        text-align: center;
        overflow: hidden;
    }

    .custom-shape-divider-bottom {
        position: absolute;
        bottom: 0;
        left: 0;
        width: 100%;
        overflow: hidden;
        line-height: 0;
    }

        .custom-shape-divider-bottom svg {
            position: relative;
            display: block;
            width: calc(130% + 1.3px);
            height: 70px;
        }

        .custom-shape-divider-bottom .shape-fill {
            fill: var(--bg-soft-mint);
        }

    /* --- GIỎ HÀNG CARD --- */
    .cart-container {
        position: relative;
        z-index: 2;
        margin-top: -50px; /* Đẩy lên đè nhẹ vào header */
    }

    .cart-card {
        background: #fff;
        border-radius: 20px;
        box-shadow: 0 10px 30px rgba(15, 157, 88, 0.1);
        border: none;
        overflow: hidden;
        padding: 20px;
    }

    /* Table Styling */
    .table thead th {
        border-bottom: 2px solid #eee;
        color: var(--primary-color);
        font-weight: 700;
        text-transform: uppercase;
        font-size: 0.9rem;
        padding: 15px;
    }

    .table tbody td {
        vertical-align: middle;
        padding: 20px 15px;
        color: #555;
        font-weight: 500;
    }

    .table img {
        border-radius: 10px;
        object-fit: cover;
        box-shadow: 0 4px 10px rgba(0,0,0,0.1);
    }

    /* Quantity Input Group */
    .btn-qty {
        width: 32px;
        height: 32px;
        border-radius: 50% !important;
        padding: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.8rem;
        transition: all 0.3s;
        border: 1px solid #eee;
    }

    .btn-minus {
        background: #fff;
        color: #555;
    }

        .btn-minus:hover {
            background: #ffeaea;
            color: #e74c3c;
            border-color: #e74c3c;
        }

    .btn-plus {
        background: #fff;
        color: #555;
    }

        .btn-plus:hover {
            background: #e8f8f5;
            color: var(--primary-color);
            border-color: var(--primary-color);
        }

    .input-qty {
        border: none;
        background: transparent;
        font-weight: 700;
        color: #333;
    }

    /* Remove Button */
    .btn-remove {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: #fff;
        border: 1px solid #eee;
        transition: all 0.3s;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .btn-remove:hover {
            background: #ffeaea;
            border-color: #e74c3c;
            transform: rotate(90deg);
        }

    /* --- CHECKOUT SECTION --- */
    .checkout-card {
        background: #fff;
        border-radius: 20px;
        padding: 30px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.05);
    }

    .checkout-input {
        background: #f9f9f9;
        border: 1px solid #eee;
        border-radius: 10px;
        padding: 12px 15px;
        width: 100%;
        margin-bottom: 15px;
        transition: all 0.3s;
    }

        .checkout-input:focus {
            outline: none;
            border-color: var(--primary-color);
            background: #fff;
            box-shadow: 0 0 0 3px rgba(15, 157, 88, 0.1);
        }

    .btn-checkout {
        background: var(--primary-color);
        color: #fff;
        width: 100%;
        padding: 15px;
        border-radius: 50px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1px;
        border: none;
        box-shadow: 0 5px 15px rgba(15, 157, 88, 0.3);
        transition: all 0.3s;
    }

        .btn-checkout:hover {
            background: var(--primary-hover);
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(15, 157, 88, 0.4);
        }

    /* Coupon Button */
    .btn-coupon {
        border: 1px solid var(--primary-color);
        color: var(--primary-color);
        background: transparent;
        border-radius: 50px;
        padding: 10px 25px;
        font-weight: 600;
        transition: all 0.3s;
    }

        .btn-coupon:hover {
            background: var(--primary-color);
            color: #fff;
        }
</style>

<div class="page-header-wave">
    <div class="container">
        <h1 class="display-5 fw-bold text-dark mb-3">Giỏ Hàng Của Bạn</h1>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb justify-content-center mb-0">
                <li class="breadcrumb-item"><a href="@Url.Action("Index_Home", "Home")" class="text-decoration-none text-muted">Trang chủ</a></li>
                <li class="breadcrumb-item active text-primary fw-bold" aria-current="page">Giỏ hàng</li>
            </ol>
        </nav>
    </div>
    <div class="custom-shape-divider-bottom">
        <svg data-name="Layer 1" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 120" preserveAspectRatio="none">
            <path d="M321.39,56.44c58-10.79,114.16-30.13,172-41.86,82.39-16.72,168.19-17.73,250.45-.39C823.78,31,906.67,72,985.66,92.83c70.05,18.48,146.53,26.09,214.34,3V0H0V27.35A600.21,600.21,0,0,0,321.39,56.44Z" class="shape-fill"></path>
        </svg>
    </div>
</div>

<div class="container pb-5 cart-container">
    <div class="row g-4">
        <div class="col-lg-8">
            <div class="cart-card animate__animated animate__fadeInUp">
                <div class="table-responsive">
                    <table class="table mb-0">
                        <thead>
                            <tr>
                                <th scope="col" class="ps-4">Sản phẩm</th>
                                <th scope="col">Đơn giá</th>
                                <th scope="col" class="text-center">Số lượng</th>
                                <th scope="col">Thành tiền</th>
                                <th scope="col" class="text-center">Xóa</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                string sessionKey = HttpContextAccessor.HttpContext.Session.GetString("UserMaNguoiDung") != null
                                ? "GioHang_" + HttpContextAccessor.HttpContext.Session.GetString("UserMaNguoiDung").ToString()
                                : "GioHang_Temp";

                                var gioHang = HttpContextAccessor.HttpContext.Session
                                .GetObject<List<HKDN_GroupUTE_BookStore.Controllers.KhachHangController.CartItem>>(sessionKey)
                                ?? new List<HKDN_GroupUTE_BookStore.Controllers.KhachHangController.CartItem>();

                                decimal tongTien = 0;

                                // ✅ Tính tổng tiền trước
                                if (gioHang != null && gioHang.Any())
                                {
                                    foreach (var item in gioHang)
                                    {
                                        tongTien += item.Gia * item.SoLuong;
                                    }
                                }

                                // ✅ Lấy coupon 1 lần
                                var couponKey = HttpContextAccessor.HttpContext.Session.GetString("UserMaNguoiDung") != null
                                ? "Voucher_" + HttpContextAccessor.HttpContext.Session.GetString("UserMaNguoiDung")
                                : "Voucher_Temp";

                                var coupon = HttpContextAccessor.HttpContext.Session
                                .GetObject<HKDN_GroupUTE_BookStore.Controllers.KhachHangController.CouponSession>(couponKey);

                                // ✅ Tính giảm giá 1 lần
                                decimal giamGia = 0;
                                if (coupon != null)
                                {
                                    giamGia = Math.Round(tongTien * (coupon.PhanTramGiam / 100m), 0);
                                    if (giamGia < 0) giamGia = 0;
                                    if (giamGia > tongTien) giamGia = tongTien;
                                }

                                if (gioHang != null && gioHang.Any())
                                {
                                    foreach (var item in gioHang)
                                    {
                                        var thanhTien = item.Gia * item.SoLuong;
                                        <tr>
                                            <td class="ps-4">
                                                <div class="d-flex align-items-center">
                                                    <img src="/images/@item.URLAnhBia" class="img-fluid" style="width: 70px; height: 90px;" alt="@item.TenSach">
                                                    <div class="ms-3">
                                                        <p class="mb-0 fw-bold text-dark">@item.TenSach</p>
                                                    </div>
                                                </div>
                                            </td>
                                            <td>
                                                <p class="mb-0">@item.Gia.ToString("N0") đ</p>
                                            </td>
                                            <td>
                                                <div class="d-flex align-items-center justify-content-center bg-light rounded-pill px-2" style="width: fit-content; margin: 0 auto;">
                                                    <button class="btn btn-qty btn-minus" data-masach="@item.MaSach">
                                                        <i class="fa fa-minus"></i>
                                                    </button>
                                                    <input type="text" class="form-control form-control-sm text-center input-qty" style="width: 40px;" value="@item.SoLuong" readonly>
                                                    <button class="btn btn-qty btn-plus" data-masach="@item.MaSach">
                                                        <i class="fa fa-plus"></i>
                                                    </button>
                                                </div>
                                            </td>
                                            <td>
                                                <p class="mb-0 fw-bold text-primary">@((int)thanhTien)đ</p>
                                            </td>
                                            <td class="text-center">
                                                <button class="btn-remove btn-remove mx-auto" data-masach="@item.MaSach">
                                                    <i class="fa fa-times text-danger"></i>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="5" class="text-center py-5">
                                            <div class="text-muted">
                                                <i class="fas fa-shopping-basket fa-3x mb-3 text-secondary"></i>
                                                <p>Giỏ hàng của bạn đang trống.</p>
                                                <a href="@Url.Action("Index_Home", "Home")" class="btn btn-outline-success rounded-pill mt-2">Mua sắm ngay</a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>

                    </table>
                </div>
            </div>

            @if (gioHang != null && gioHang.Any())
            {
                <div class="cart-card mt-4 p-4 animate__animated animate__fadeInUp" style="animation-delay: 0.1s;">
                    <div class="d-flex flex-wrap align-items-center">
                        <input id="couponCode" type="text" class="checkout-input me-3 mb-0" style="max-width: 300px;"
                               placeholder="Nhập mã giảm giá (VD: SALE10)">
                        <button class="btn-coupon" type="button">Áp dụng</button>
                    </div>
                </div>
            }
        </div>

        <div class="col-lg-4">
            <div class="checkout-card animate__animated animate__fadeInRight">
                <h4 class="fw-bold text-dark mb-4">Tổng Giỏ Hàng</h4>

                <div class="d-flex justify-content-between mb-3">
                    <span class="text-muted">Tổng phụ:</span>
                    <span class="fw-bold">@((int)tongTien)đ</span>
                </div>

                <div class="d-flex justify-content-between mb-3">
                    <span class="text-muted">Vận chuyển:</span>
                    <span class="fw-bold">30.000đ</span>
                </div>
                @if (coupon != null)
                {
                    <div class="d-flex justify-content-between mb-3">
                        <span class="text-muted">Giảm giá (@coupon.MaVoucher - @coupon.PhanTramGiam%):</span>
                        <span class="fw-bold text-danger">-@((int)giamGia)đ</span>
                    </div>
                }

                <div class="alert alert-info py-2 small rounded-3 mb-4">
                    <i class="fas fa-truck me-2"></i> Vận chuyển đến: <strong>Đà Nẵng</strong>
                </div>

                <hr class="my-4" style="opacity: 0.1">

                <div class="d-flex justify-content-between mb-4">
                    <h5 class="fw-bold text-primary">Tổng cộng:</h5>
                    <h5 class="fw-bold text-primary">@((int)(tongTien - giamGia + 30000))đ</h5>
                </div>

                <div class="mb-4">
                    <label class="form-label fw-bold small">Địa chỉ giao hàng (*)</label>
                    <input type="text" class="checkout-input" id="diaChiGiao" placeholder="Số nhà, đường, phường, quận...">
                </div>

                <button class="btn-dat-hang btn-checkout" type="button">
                    Tiến Hành Đặt Hàng <i class="fas fa-arrow-right ms-2"></i>
                </button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="orderSuccessModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow rounded-4">
            <div class="modal-header bg-success text-white border-0 rounded-top-4">
                <h5 class="modal-title"><i class="fas fa-check-circle me-2"></i>Thành công</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-center py-4">
                <h4 class="text-success fw-bold">Đặt hàng thành công!</h4>
                <p class="text-muted">Cảm ơn bạn đã mua sắm tại Nhà sách UTE.</p>
            </div>
            <div class="modal-footer border-0 justify-content-center pb-4">
                <button type="button" class="btn btn-success rounded-pill px-5" data-bs-dismiss="modal" id="orderOkButton">OK</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // LOGIC CŨ GIỮ NGUYÊN - CHỈ CẦN CLASS TRONG HTML KHỚP LÀ CHẠY

            // Xử lý tăng số lượng
            $(".btn-plus").click(function () {
                var maSach = $(this).data("masach");
                $.ajax({
                    url: '@Url.Action("ThemVaoGioHang", "KhachHang")',
                    type: 'POST',
                    data: { maSach: maSach },
                    success: function (response) {
                        if (response.success) { location.reload(); }
                        else { alert(response.message); }
                    },
                    error: function () { alert("Lỗi cập nhật giỏ hàng."); }
                });
            });

            // Xử lý giảm số lượng
            $(".btn-minus").click(function () {
                var maSach = $(this).data("masach");
                // Lưu ý: Logic lấy JS variable gioHang từ ViewBag có thể cần check lại ở Controller
                // nhưng mình giữ nguyên code JS gốc của bạn để đảm bảo không break logic.
                // Nếu ViewBag.GioHangJson không null thì đoạn dưới sẽ chạy đúng.
                var gioHang = @Html.Raw(ViewBag.GioHangJson ?? "[]");
                var item = gioHang.find(x => x.MaSach === maSach);

                // Fallback nếu client-side logic cần, hoặc server xử lý giảm luôn
                // Ở đây gọi AJAX giảm số lượng
                 $.ajax({
                    url: '@Url.Action("ThemVaoGioHang", "KhachHang")',
                    type: 'POST',
                    data: { maSach: maSach, giamSoLuong: true }, // Logic backend phải support param này
                    success: function (response) {
                        if (response.success) { location.reload(); }
                        else { alert(response.message); }
                    },
                    error: function () { alert("Lỗi cập nhật giỏ hàng."); }
                });
            });

            // Xử lý xóa sản phẩm
            $(".btn-remove").click(function () {
                var maSach = $(this).data("masach");
                $.ajax({
                    url: '@Url.Action("ThemVaoGioHang", "KhachHang")',
                    type: 'POST',
                    data: { maSach: maSach, xoaSanPham: true },
                    success: function (response) {
                        if (response.success) { location.reload(); }
                        else { alert(response.message); }
                    },
                    error: function () { alert("Lỗi xóa sản phẩm."); }
                });
            });
                    $(".btn-coupon").click(function () {
            var code = $("#couponCode").val();

            if (!code) {
                alert("Vui lòng nhập mã giảm giá.");
                $("#couponCode").focus();
                return;
            }

            $.ajax({
                url: '@Url.Action("ApDungMaGiamGia", "KhachHang")',
                type: 'POST',
                data: { maVoucher: code },
                success: function (response) {
                    if (response.success) {
                        alert(response.message);
                        location.reload(); // đơn giản + chắc chắn đúng tổng tiền
                    } else {
                        alert(response.message);
                    }
                },
                error: function () {
                    alert("Lỗi áp dụng mã giảm giá.");
                }
            });
        });


            // Xử lý đặt hàng
            $(".btn-dat-hang").click(function () {
                var diaChiGiao = $("#diaChiGiao").val();
                if (!diaChiGiao) {
                    alert("Vui lòng nhập địa chỉ giao hàng.");
                    $("#diaChiGiao").focus(); // Thêm UX focus vào ô nhập
                    return;
                }

                // Hiệu ứng loading nút
                var btn = $(this);
                var originalText = btn.html();
                btn.html('<i class="fas fa-spinner fa-spin"></i> Đang xử lý...').prop('disabled', true);

                $.ajax({
                    url: '@Url.Action("DatHang", "KhachHang")',
                    type: 'POST',
                    data: { diaChiGiao: diaChiGiao },
                    success: function (response) {
                        if (response.success) {
                            $("#orderSuccessModal").modal('show');
                        } else {
                            alert(response.message);
                            btn.html(originalText).prop('disabled', false);
                        }
                    },
                    error: function () {
                        alert("Đã có lỗi xảy ra khi đặt hàng.");
                        btn.html(originalText).prop('disabled', false);
                    }
                });
            });

            // Xử lý nút OK trong modal
            $("#orderOkButton").click(function () {
                window.location.href = '@Url.Action("Index_Home", "Home")';
            });
        });
    </script>
}