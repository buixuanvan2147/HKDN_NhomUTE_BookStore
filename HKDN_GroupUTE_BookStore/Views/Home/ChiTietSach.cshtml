@model HKDN_GroupUTE_BookStore.ViewModel.ChiTietSachVM
@{
    ViewBag.Title = Model.TenSach;
    Layout = "~/Views/Shared/_Layout.cshtml";

    // --- LOGIC XỬ LÝ DỮ LIỆU AN TOÀN ---
    // Kiểm tra tồn kho (đảm bảo không âm)
    int stockAvailable = (Model.SoLuongTon > 0) ? Model.SoLuongTon : 0;

    // Xử lý hiển thị text
    string tacGiaDisplay = string.IsNullOrEmpty(Model.TacGia) ? "Đang cập nhật" : Model.TacGia;
    string moTaDisplay = string.IsNullOrEmpty(Model.MoTa) ? "Chưa có mô tả chi tiết cho sản phẩm này." : Model.MoTa;
    string tenTheLoaiDisplay = string.IsNullOrEmpty(Model.TenTheLoai) ? "Khác" : Model.TenTheLoai;

    // Lấy danh sách sách tương tự từ ViewBag (nếu có)
    var listTuongTu = ViewBag.SachTuongTu as List<HKDN_GroupUTE_BookStore.ViewModel.ChiTietSachVM>;
}

<style>
    /* --- STYLE SETTINGS (SOFT MINT THEME) --- */
    :root {
        --primary-color: #0F9D58;
        --primary-hover: #0B8043;
        --bg-soft-mint: #f2fbf7;
        --text-dark: #333;
    }

    body {
        background-color: var(--bg-soft-mint);
    }

    /* 1. Header Wave Effect */
    .page-header-wave {
        background: linear-gradient(135deg, rgba(204, 251, 241, 0.95) 0%, rgba(224, 242, 254, 0.95) 100%);
        padding: 60px 0 100px 0;
        position: relative;
        text-align: center;
        overflow: hidden;
    }

    .custom-shape-divider-bottom {
        position: absolute;
        bottom: 0;
        left: 0;
        width: 100%;
        overflow: hidden;
        line-height: 0;
    }

        .custom-shape-divider-bottom svg {
            position: relative;
            display: block;
            width: calc(130% + 1.3px);
            height: 70px;
        }

        .custom-shape-divider-bottom .shape-fill {
            fill: var(--bg-soft-mint);
        }

    /* 2. Product Card */
    .product-container {
        position: relative;
        z-index: 2;
        margin-top: -50px;
    }

    .product-card {
        background: #fff;
        border-radius: 20px;
        box-shadow: 0 15px 35px rgba(15, 157, 88, 0.1);
        padding: 40px;
    }

    /* 3. Image & Stock Badge */
    .product-img-wrapper {
        display: flex;
        align-items: center;
        justify-content: center;
        background: #fff;
        border-radius: 15px;
        padding: 10px;
        height: 100%;
        min-height: 400px;
        position: relative;
    }

    .product-img {
        max-height: 450px;
        width: auto;
        max-width: 100%;
        object-fit: contain;
        transition: transform 0.3s;
        filter: drop-shadow(0 10px 15px rgba(0,0,0,0.1));
    }

        .product-img:hover {
            transform: scale(1.02);
        }

        /* Hiệu ứng khi hết hàng */
        .product-img.sold-out {
            opacity: 0.4;
            filter: grayscale(100%);
        }

    .out-of-stock-badge {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        background: rgba(0, 0, 0, 0.75);
        color: white;
        padding: 10px 20px;
        font-size: 1.2rem;
        font-weight: bold;
        text-transform: uppercase;
        border-radius: 8px;
        z-index: 10;
        pointer-events: none;
        backdrop-filter: blur(2px);
    }

    /* 4. Text Info */
    .product-title {
        color: var(--text-dark);
        font-weight: 800;
        font-size: 2rem;
        line-height: 1.2;
    }

    .product-price {
        color: var(--primary-color);
        font-size: 2.2rem;
        font-weight: 700;
        margin: 15px 0;
    }

    .meta-tag {
        display: inline-block;
        background: #f8f9fa;
        padding: 8px 15px;
        border-radius: 50px;
        font-size: 0.95rem;
        color: #555;
        margin-right: 10px;
        margin-bottom: 10px;
        border: 1px solid #eee;
    }

        .meta-tag strong {
            color: var(--text-dark);
            font-weight: 700;
            margin-right: 5px;
        }

        .meta-tag i {
            color: var(--primary-color);
        }

    /* 5. Quantity Input */
    .quantity-control {
        display: flex;
        align-items: center;
        background: #f8f9fa;
        border-radius: 50px;
        padding: 5px;
        width: fit-content;
        border: 1px solid #eee;
    }

    .btn-qty {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        border: none;
        background: #fff;
        box-shadow: 0 2px 5px rgba(0,0,0,0.05);
        color: #333;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s;
        cursor: pointer;
    }

        .btn-qty:hover {
            background: var(--primary-color);
            color: #fff;
        }

    .input-qty {
        width: 60px;
        text-align: center;
        border: none;
        background: transparent;
        font-weight: 700;
        font-size: 1.1rem;
        outline: none;
    }

    /* 6. Buttons */
    .btn-add-cart {
        background-color: var(--primary-color);
        color: #fff;
        border: none;
        padding: 12px 40px;
        font-size: 1.1rem;
        font-weight: 600;
        border-radius: 50px;
        transition: all 0.3s;
        box-shadow: 0 5px 15px rgba(15, 157, 88, 0.3);
    }

        .btn-add-cart:hover {
            background-color: var(--primary-hover);
            transform: translateY(-3px);
        }

        .btn-add-cart:disabled {
            background-color: #ccc;
            cursor: not-allowed;
            transform: none;
            box-shadow: none;
        }

    /* 7. Related Books Style */
    .related-book-card {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        border-radius: 15px !important;
        overflow: hidden;
    }

        .related-book-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(15, 157, 88, 0.15) !important;
        }

    .related-img-container {
        height: 250px;
        background: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
    }
</style>

<div class="page-header-wave">
    <div class="container">
        <h1 class="display-5 fw-bold text-dark mb-3">Chi Tiết Sản Phẩm</h1>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb justify-content-center mb-0">
                <li class="breadcrumb-item"><a href="@Url.Action("Index_Home", "Home")" class="text-decoration-none text-muted">Trang chủ</a></li>
                <li class="breadcrumb-item"><a href="#" class="text-decoration-none text-muted">Sách</a></li>
                <li class="breadcrumb-item active text-primary fw-bold" aria-current="page">@Model.TenSach</li>
            </ol>
        </nav>
    </div>
    <div class="custom-shape-divider-bottom">
        <svg data-name="Layer 1" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 120" preserveAspectRatio="none">
            <path d="M321.39,56.44c58-10.79,114.16-30.13,172-41.86,82.39-16.72,168.19-17.73,250.45-.39C823.78,31,906.67,72,985.66,92.83c70.05,18.48,146.53,26.09,214.34,3V0H0V27.35A600.21,600.21,0,0,0,321.39,56.44Z" class="shape-fill"></path>
        </svg>
    </div>
</div>

<div class="container pb-5 product-container">
    <div class="product-card animate__animated animate__fadeInUp">
        <div class="row g-5">
            <div class="col-lg-5">
                <div class="product-img-wrapper">
                    @if (stockAvailable == 0)
                    {
                        <div class="out-of-stock-badge">HẾT HÀNG</div>
                    }
                    <img src="~/images/@Model.Hinh"
                         class="img-fluid product-img @(stockAvailable == 0 ? "sold-out" : "")"
                         alt="@Model.TenSach"
                         onerror="this.src='https://via.placeholder.com/400x600?text=No+Image';">
                </div>
            </div>

            <div class="col-lg-7">
                <div class="ps-lg-4">
                    <h2 class="product-title mb-3">@Model.TenSach</h2>

                    <div class="mb-4">
                        <div class="d-flex flex-wrap gap-2">
                            <span class="meta-tag"><i class="fas fa-user-edit me-2"></i><strong>Tác giả:</strong> @tacGiaDisplay</span>
                            <span class="meta-tag"><i class="fas fa-book me-2"></i><strong>Thể loại:</strong> @tenTheLoaiDisplay</span>
                            <span class="meta-tag">
                                <i class="fas fa-box-open me-2"></i>
                                <strong>Tình trạng:</strong>
                                @if (stockAvailable > 0)
                                {
                                    <span class="text-success fw-bold">Còn hàng (@stockAvailable)</span>
                                }
                                else
                                {

                                    <span class="text-danger fw-bold">Hết hàng</span>
                                }
                            </span>
                        </div>
                    </div>

                    <div class="mb-4 text-warning small">
                        <i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i>
                        <span class="text-muted ms-2">(Đánh giá khách hàng)</span>
                    </div>

                    <h3 class="product-price">@Model.DonGia.ToString("N0") đ</h3>

                    <p class="text-muted mb-4" style="line-height: 1.8; text-align: justify;">
                        @moTaDisplay
                    </p>

                    <hr class="my-4" style="opacity: 0.1;">

                    @using (Html.BeginForm("ThemVaoGioHang", "GioHang", FormMethod.Post, new { id = "addToCartForm" }))
                    {
                        @Html.AntiForgeryToken()
                        @Html.Hidden("maSach", Model.MaSach)

                        <div class="d-flex flex-wrap align-items-end gap-4">
                            <div>
                                <label class="fw-bold small text-muted mb-2 d-block">Số lượng:</label>
                                <div class="quantity-control">
                                    <button type="button" class="btn-qty" onclick="changeQuantity(-1)" @(stockAvailable == 0 ? "disabled" : "")>
                                        <i class="fas fa-minus"></i>
                                    </button>

                                    <input type="text" class="input-qty" id="soLuong" name="soLuong"
                                           value="@(stockAvailable > 0 ? 1 : 0)"
                                           onkeypress="return event.charCode >= 48 && event.charCode <= 57"
                                           onchange="validateInput(this)"
                                           @(stockAvailable == 0 ? "readonly" : "")>

                                    <button type="button" class="btn-qty" onclick="changeQuantity(1)" @(stockAvailable == 0 ? "disabled" : "")>
                                        <i class="fas fa-plus"></i>
                                    </button>
                                </div>
                            </div>

                            <div>
                                @if (stockAvailable > 0)
                                {
                                    <button type="submit" class="btn-add-cart">
                                        <i class="fas fa-cart-plus me-2"></i> Thêm vào giỏ
                                    </button>
                                }
                                else
                                {
                                    <button type="button" class="btn-add-cart" disabled style="background-color: #999; box-shadow:none;">
                                        <i class="fas fa-ban me-2"></i> Hết hàng
                                    </button>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@if (listTuongTu != null && listTuongTu.Count > 0)
{
    <div class="container mb-5">
        <div class="d-flex align-items-center mb-4 mt-5">
            <h3 class="fw-bold text-dark m-0">
                <i class="fas fa-layer-group text-success me-2"></i>Sách Cùng Thể Loại
            </h3>
            <div class="ms-3 flex-grow-1" style="height: 2px; background: #e9ecef;"></div>
        </div>

        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-4 g-4">
            @foreach (var item in listTuongTu)
            {
                <div class="col">
                    <div class="card h-100 border-0 shadow-sm related-book-card">
                        <div class="related-img-container rounded-top-3">
                            <a href="@Url.Action("ChiTietSach", "Home", new { maSach = item.MaSach })">
                                <img src="~/images/@item.Hinh" class="card-img-top w-100 h-100 object-fit-contain p-3"
                                     alt="@item.TenSach"
                                     onerror="this.src='https://via.placeholder.com/200x300?text=No+Image';">
                            </a>
                        </div>
                        <div class="card-body bg-white rounded-bottom-3 text-center">
                            <h6 class="card-title text-truncate mb-2">
                                <a href="@Url.Action("ChiTietSach", "Home", new { maSach = item.MaSach })" class="text-decoration-none text-dark fw-bold stretched-link">
                                    @item.TenSach
                                </a>
                            </h6>
                            <p class="card-text text-success fw-bold">@item.DonGia.ToString("N0") đ</p>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
}

<div class="modal fade" id="cartModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow rounded-4">
            <div class="modal-header bg-success text-white border-0 rounded-top-4">
                <h5 class="modal-title"><i class="fas fa-check-circle me-2"></i>Thành công</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-center py-4 fs-5">
                Đã thêm sản phẩm vào giỏ hàng!
            </div>
            <div class="modal-footer border-0 justify-content-center">
                <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Ở lại trang</button>
                <a href="@Url.Action("Index", "Home")" class="btn btn-success rounded-pill px-5">Về trang chủ</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Lấy số lượng tồn kho từ Server truyền xuống
        var maxStock = @stockAvailable;

        // Hàm 1: Validate input nhập tay
        function validateInput(el) {
            let val = parseInt(el.value);
            if (isNaN(val) || val < 1) {
                // Nếu nhập sai hoặc < 1, reset về 1 (hoặc 0 nếu hết hàng)
                el.value = (maxStock > 0) ? 1 : 0;
            } else if (val > maxStock) {
                // Nếu nhập quá tồn kho
                el.value = maxStock;
                alert("Số lượng mua tối đa là " + maxStock + " sản phẩm.");
            }
        }

        // Hàm 2: Xử lý nút cộng trừ
        function changeQuantity(delta) {
            if (maxStock <= 0) return;

            var input = document.getElementById('soLuong');
            var currentValue = parseInt(input.value);
            if (isNaN(currentValue)) currentValue = 1;

            var newValue = currentValue + delta;

            if (newValue >= 1 && newValue <= maxStock) {
                input.value = newValue;
            }
        }

        // Hàm 3: Ajax Thêm vào giỏ
        $(document).ready(function () {
            $("#addToCartForm").submit(function (e) {
                e.preventDefault(); // Chặn reload trang

                if (maxStock <= 0) {
                    alert("Sản phẩm này đã hết hàng.");
                    return;
                }

                var form = $(this);
                var btn = form.find('.btn-add-cart');
                var originalHtml = btn.html();

                // Hiệu ứng Loading
                btn.html('<i class="fas fa-spinner fa-spin"></i> Đang xử lý...').prop('disabled', true);

                // Bước 1: Kiểm tra đăng nhập
                $.ajax({
                    url: '@Url.Action("KiemTraDangNhap", "KhachHang")', // Đảm bảo URL này đúng Controller của bạn
                    type: 'POST',
                    success: function (response) {
                        if (response.loggedIn) {
                            // Bước 2: Nếu đã Login -> Gửi form thêm giỏ hàng
                            $.ajax({
                                url: form.attr('action'),
                                type: form.attr('method'),
                                data: form.serialize(),
                                success: function (resCart) {
                                    if (resCart.success) {
                                        $("#cartModal").modal('show');
                                    } else {
                                        alert(resCart.message || "Không thể thêm vào giỏ.");
                                    }
                                    btn.html(originalHtml).prop('disabled', false);
                                },
                                error: function () {
                                    alert("Lỗi kết nối Server.");
                                    btn.html(originalHtml).prop('disabled', false);
                                }
                            });
                        } else {
                            // Chưa login -> Chuyển trang đăng nhập
                            alert("Bạn cần đăng nhập để mua hàng.");
                            window.location.href = '@Url.Action("DangNhap", "Home")?returnUrl=' + window.location.pathname;
                        }
                    },
                    error: function () {
                        // Nếu Action KiemTraDangNhap không tồn tại hoặc lỗi
                        alert("Lỗi kiểm tra trạng thái đăng nhập. Vui lòng thử lại.");
                        btn.html(originalHtml).prop('disabled', false);
                    }
                });
            });
        });
    </script>
}