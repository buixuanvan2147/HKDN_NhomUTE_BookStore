@model HKDN_GroupUTE_BookStore.Controllers.KhachHangController.UserViewModel
@{
    ViewBag.Title = "Thông tin người dùng";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    /* --- 1. CONFIG MÀU SẮC (THEME MINT & PASTEL) --- */
    :root {
        --primary-color: #0F9D58; /* Xanh lá chủ đạo */
        --primary-hover: #0B8043;
        --bg-soft-mint: #f0fdf4; /* Nền trang rất nhạt */
        --text-dark: #1e293b; /* Màu chữ đen xám hiện đại */
        /* Màu trạng thái (Nền nhạt + Chữ đậm) */
        --warning-bg: #fffbeb;
        --warning-text: #b45309;
        --info-bg: #eff6ff;
        --info-text: #1d4ed8;
        --primary-bg: #ecfdf5;
        --primary-text: #047857;
        --success-bg: #f0fdfa;
        --success-text: #0f766e;
        --danger-bg: #fef2f2;
        --danger-text: #b91c1c;
    }

    body {
        background-color: var(--bg-soft-mint);
        color: var(--text-dark);
        font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    }

    /* --- 2. HEADER WAVE --- */
    .page-header-wave {
        background: linear-gradient(135deg, #d1fae5 0%, #e0f2fe 100%);
        padding: 50px 0 90px 0;
        position: relative;
        text-align: center;
    }

    .custom-shape-divider-bottom {
        position: absolute;
        bottom: 0;
        left: 0;
        width: 100%;
        overflow: hidden;
        line-height: 0;
    }

        .custom-shape-divider-bottom svg {
            position: relative;
            display: block;
            width: calc(130% + 1.3px);
            height: 60px;
        }

        .custom-shape-divider-bottom .shape-fill {
            fill: var(--bg-soft-mint);
        }

    /* --- 3. LAYOUT & CARDS --- */
    .user-container {
        margin-top: -40px;
        position: relative;
        z-index: 2;
    }

    .info-card {
        background: white;
        border-radius: 12px;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -1px rgba(0, 0, 0, 0.03);
        padding: 24px;
        height: 100%;
        border: 1px solid #e2e8f0;
    }

    .sticky-user-info {
        position: sticky;
        top: 20px;
    }

    .info-card h2 {
        color: var(--primary-color);
        font-size: 1.1rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        border-bottom: 2px solid #f1f5f9;
        padding-bottom: 12px;
        margin-bottom: 20px;
    }

    /* --- 4. FORM INPUT --- */
    .form-label {
        font-size: 0.85rem;
        font-weight: 600;
        color: #475569;
        margin-bottom: 6px;
    }

    .custom-input {
        background-color: #f8fafc;
        border: 1px solid #cbd5e1;
        border-radius: 8px;
        font-size: 0.9rem;
        padding: 10px 12px;
        transition: all 0.2s;
    }

        .custom-input:focus {
            background-color: white;
            border-color: var(--primary-color);
            box-shadow: 0 0 0 3px rgba(15, 157, 88, 0.1);
        }

    /* --- 5. TABLE STYLES --- */
    .table-container {
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        overflow: hidden;
    }

    .table thead th {
        background-color: #f8fafc;
        color: #64748b;
        font-size: 0.75rem;
        text-transform: uppercase;
        font-weight: 700;
        border-bottom: 1px solid #e2e8f0;
        padding: 14px 10px;
        white-space: nowrap;
    }

    .table tbody td {
        vertical-align: middle;
        font-size: 0.9rem;
        padding: 12px 10px;
        border-bottom: 1px solid #f1f5f9;
    }

    /* --- 6. BADGES (FIXED WIDTH - QUAN TRỌNG) --- */
    .badge-status {
        display: inline-block;
        width: 120px; /* Độ rộng cố định để không bị so le */
        padding: 6px 0;
        border-radius: 50px;
        font-size: 0.75rem;
        font-weight: 700;
        text-align: center;
    }

    .status-cho-xac-nhan {
        background-color: var(--warning-bg);
        color: var(--warning-text);
    }

    .status-dang-xu-ly {
        background-color: var(--info-bg);
        color: var(--info-text);
    }

    .status-dang-giao {
        background-color: var(--primary-bg);
        color: var(--primary-text);
    }

    .status-hoan-thanh {
        background-color: var(--success-bg);
        color: var(--success-text);
    }

    .status-da-huy {
        background-color: var(--danger-bg);
        color: var(--danger-text);
    }

    /* --- 7. BUTTONS --- */
    .btn-icon-circle {
        width: 34px;
        height: 34px;
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        margin: 0 2px;
        transition: all 0.2s;
        border: 1px solid transparent;
        background: white;
    }

    .btn-view {
        color: var(--primary-color);
        border-color: #bbf7d0;
    }

        .btn-view:hover {
            background-color: var(--primary-color);
            color: white;
            border-color: var(--primary-color);
        }

    .btn-edit {
        color: #d97706;
        border-color: #fed7aa;
    }

        .btn-edit:hover {
            background-color: #d97706;
            color: white;
            border-color: #d97706;
        }

    .btn-cancel-mini {
        color: #ef4444;
        border-color: #fecaca;
    }

        .btn-cancel-mini:hover {
            background-color: #ef4444;
            color: white;
            border-color: #ef4444;
        }

    .btn-confirm-received {
        background-color: var(--primary-color);
        color: white;
        border: none;
        border-radius: 20px;
        padding: 6px 14px;
        font-size: 0.8rem;
        font-weight: 600;
    }

        .btn-confirm-received:hover {
            background-color: var(--primary-hover);
            transform: translateY(-1px);
        }

    .btn-save-info {
        background-color: var(--primary-color);
        border: none;
        font-weight: 600;
    }

        .btn-save-info:hover {
            background-color: var(--primary-hover);
        }

    /* --- 8. MODAL & CHI TIẾT SẢN PHẨM (QUAN TRỌNG) --- */
    .product-row {
        display: flex;
        align-items: center;
        padding: 10px 0;
        border-bottom: 1px solid #f1f5f9;
    }

        .product-row:last-child {
            border-bottom: none;
        }

    .product-img {
        width: 50px;
        height: 70px;
        object-fit: cover;
        border-radius: 6px;
        border: 1px solid #eee;
        flex-shrink: 0; /* Không bị co ảnh */
    }

    .product-info {
        flex-grow: 1;
        padding: 0 15px;
        min-width: 0; /* Cần thiết để text-truncate hoạt động trong Flexbox */
    }

    .product-name {
        font-weight: 600;
        color: #334155;
        margin-bottom: 2px;
        /* Xử lý tràn dòng */
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        display: block;
    }

    .product-price {
        white-space: nowrap; /* Giá tiền không xuống dòng */
        font-weight: 700;
        color: var(--primary-color);
        flex-shrink: 0;
    }

    /* Modal Hủy Đơn đẹp */
    .icon-danger-box {
        width: 60px;
        height: 60px;
        background-color: #fef2f2;
        color: #ef4444;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 15px;
        font-size: 24px;
    }

    /* --- Style cho Modal Đánh Giá Nhanh --- */
    #reviewProductList .card {
        border: none;
        transition: all 0.3s ease;
        border-radius: 15px;
    }

        #reviewProductList .card:hover {
            background-color: #f0fdf4 !important; /* Màu xanh mint cực nhạt khi hover */
            transform: translateY(-2px);
        }

    /* Style cho hệ thống chọn sao mini */
    .star-rating-mini {
        display: flex;
        flex-direction: row-reverse;
        justify-content: flex-end;
        gap: 8px;
    }

        .star-rating-mini input {
            display: none;
        }

        .star-rating-mini label {
            font-size: 1.8rem;
            color: #cbd5e0;
            cursor: pointer;
            transition: color 0.2s, transform 0.2s;
        }

            /* Hiệu ứng khi hover hoặc được chọn */
            .star-rating-mini label:hover,
            .star-rating-mini label:hover ~ label,
            .star-rating-mini input:checked ~ label {
                color: #fbbf24;
                transform: scale(1.1);
            }

    .btn-submit-review {
        border-radius: 10px;
        font-weight: 600;
        padding: 8px 20px;
        transition: all 0.2s;
    }
</style>

<div class="page-header-wave">
    <div class="container">
        <h1 class="display-6 fw-bold text-dark mb-2">Hồ Sơ Của Bạn</h1>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb justify-content-center mb-0 small">
                <li class="breadcrumb-item"><a href="@Url.Action("Index_Home", "Home")" class="text-decoration-none text-muted">Trang chủ</a></li>
                <li class="breadcrumb-item active text-primary fw-bold" aria-current="page">Tài khoản</li>
            </ol>
        </nav>
    </div>
    <div class="custom-shape-divider-bottom">
        <svg data-name="Layer 1" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 120" preserveAspectRatio="none">
            <path d="M321.39,56.44c58-10.79,114.16-30.13,172-41.86,82.39-16.72,168.19-17.73,250.45-.39C823.78,31,906.67,72,985.66,92.83c70.05,18.48,146.53,26.09,214.34,3V0H0V27.35A600.21,600.21,0,0,0,321.39,56.44Z" class="shape-fill"></path>
        </svg>
    </div>
</div>

<div class="container pb-5 user-container">
    <div class="row g-4">
        <div class="col-lg-4">
            <div class="info-card sticky-user-info animate__animated animate__fadeInLeft">
                <h2><i class="fas fa-id-card me-2"></i>Thông tin cá nhân</h2>

                <div class="form-group mb-3">
                    <label class="form-label">Họ tên</label>
                    <input type="text" class="form-control custom-input" id="hoTen" value="@Model.HoTen" placeholder="Nhập họ tên">
                </div>

                <div class="form-group mb-3">
                    <label class="form-label">Email</label>
                    <input type="email" class="form-control custom-input" id="email" value="@Model.Email" placeholder="Nhập email">
                </div>

                <div class="form-group mb-3">
                    <label class="form-label">Số điện thoại</label>
                    <input type="text" class="form-control custom-input" id="soDienThoai" value="@Model.SoDienThoai" placeholder="Nhập số điện thoại">
                </div>

                <div class="form-group mb-4">
                    <label class="form-label">Địa chỉ</label>
                    <input type="text" class="form-control custom-input" id="diaChi" value="@Model.DiaChi" placeholder="Nhập địa chỉ giao hàng">
                </div>

                <button class="btn btn-primary w-100 rounded-pill py-2 btn-save-info shadow-sm" type="button">
                    <i class="fas fa-save me-2"></i> Lưu thay đổi
                </button>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="info-card animate__animated animate__fadeInRight" style="min-height: 500px;">
                <h2><i class="fas fa-box-open me-2"></i>Lịch sử đơn hàng</h2>

                <div class="table-container">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead>
                                <tr>
                                    <th class="text-start ps-4">Mã Đơn</th>
                                    <th>Ngày Đặt</th>
                                    <th>Tổng Tiền</th>
                                    <th class="text-center">Trạng Thái</th>
                                    <th class="text-center">Chi Tiết</th>
                                    <th class="text-end pe-4">Thao Tác</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.DonHangs != null && Model.DonHangs.Any())
                                {
                                    foreach (var donHang in Model.DonHangs)
                                    {
                                        <tr>
                                            <td class="text-start ps-4 fw-bold text-primary">@donHang.MaDonHang</td>
                                            <td>@donHang.NgayTao.ToString("dd/MM/yy HH:mm")</td>
                                            <td class="fw-bold">@donHang.TongTien.ToString("N0") đ</td>

                                            <td class="text-center">
                                                @if (donHang.TrangThaiDonHang == "ChoXacNhan")
                                                {
                                                    <span class="badge-status status-cho-xac-nhan">Chờ xác nhận</span>
                                                }
                                                else if (donHang.TrangThaiDonHang == "DangXuLy")
                                                {

                                                    <span class="badge-status status-dang-xu-ly">Đang xử lý</span>
                                                }
                                                else if (donHang.TrangThaiDonHang == "DangGiao")
                                                {

                                                    <span class="badge-status status-dang-giao">Đang giao</span>
                                                }
                                                else if (donHang.TrangThaiDonHang == "DaGiao")
                                                {

                                                    <span class="badge-status status-hoan-thanh">Hoàn thành</span>
                                                }
                                                else if (donHang.TrangThaiDonHang == "DaHuy")
                                                {

                                                    <span class="badge-status status-da-huy">Đã hủy</span>
                                                }
                                            </td>

                                            <td class="text-center">
                                                <button class="btn btn-icon-circle btn-view btn-view-detail"
                                                        title="Xem chi tiết"
                                                        data-madon="@donHang.MaDonHang"
                                                        data-ngay="@donHang.NgayTao.ToString("dd/MM/yyyy")">
                                                    <i class="fas fa-eye"></i>
                                                </button>

                                                <div id="detail-data-@donHang.MaDonHang" class="d-none">
                                                    @foreach (var ct in donHang.ChiTiets)
                                                    {
                                                        <div class="product-row">
                                                            <img src="~/images/@ct.URLAnhBia" class="product-img">
                                                            <div class="product-info">
                                                                <div class="product-name" title="@ct.TenSach">@ct.TenSach</div>
                                                                <small class="text-muted">SL: @ct.SoLuong</small>
                                                            </div>
                                                            <div class="product-price">
                                                                @((ct.SoLuong * ct.GiaBan).ToString("N0"))đ
                                                            </div>
                                                        </div>
                                                    }
                                                </div>
                                            </td>

                                            <td class="text-end pe-4" style="min-width: 150px;">
                                                @if (donHang.TrangThaiDonHang == "ChoXacNhan" || donHang.TrangThaiDonHang == "DangXuLy")
                                                {
                                                    <button class="btn btn-icon-circle btn-edit btn-edit-order" title="Sửa đơn">
                                                        <i class="fas fa-pen small"></i>
                                                    </button>
                                                    <button class="btn btn-icon-circle btn-cancel-mini btn-cancel-trigger"
                                                            title="Hủy đơn"
                                                            data-madonhang="@donHang.MaDonHang">
                                                        <i class="fas fa-times"></i>
                                                    </button>
                                                }
                                                else if (donHang.TrangThaiDonHang == "DangGiao")
                                                {
                                                    <button class="btn btn-confirm-received btn-received-order"
                                                            data-madonhang="@donHang.MaDonHang">
                                                        <i class="fas fa-check me-1"></i> Đã nhận
                                                    </button>
                                                }
                                                else if (donHang.TrangThaiDonHang == "DaGiao")
                                                {
                                                    <span class="text-success small fw-bold"><i class="fas fa-check-circle"></i> Xong</span>
                                                }
                                                else if (donHang.TrangThaiDonHang == "DaHuy")
                                                {
                                                    <span class="text-muted small"><i class="fas fa-ban"></i> Hủy</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="6" class="text-center py-5 text-muted">
                                            <i class="fas fa-shopping-basket fa-2x mb-2 opacity-50"></i>
                                            <p class="mb-0">Chưa có đơn hàng nào</p>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="confirmCancelModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content border-0 shadow rounded-4 overflow-hidden">
            <div class="modal-body text-center p-4">
                <div class="icon-danger-box animate__animated animate__pulse animate__infinite">
                    <i class="fas fa-exclamation-triangle"></i>
                </div>
                <h5 class="fw-bold text-dark mb-2">Hủy đơn hàng?</h5>
                <p class="text-muted small mb-4">Bạn có chắc muốn hủy đơn <span id="cancelOrderIdDisplay" class="fw-bold text-dark"></span>? <br>Hành động này không thể hoàn tác.</p>

                <div class="d-flex gap-2 justify-content-center">
                    <button type="button" class="btn btn-light rounded-pill w-50 fw-bold" data-bs-dismiss="modal">Không</button>
                    <button type="button" class="btn btn-danger rounded-pill w-50 fw-bold" id="btnConfirmCancel">Hủy ngay</button>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="infoModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content border-0 shadow rounded-4">
            <div class="modal-body text-center py-4">
                <div class="mb-3 text-primary">
                    <i class="fas fa-info-circle fa-2x"></i>
                </div>
                <p id="infoModalBody" class="fw-bold text-dark mb-0"></p>
            </div>
            <div class="modal-footer border-0 justify-content-center pt-0">
                <button type="button" class="btn btn-primary rounded-pill px-4 btn-sm" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="detailModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow rounded-4">
            <div class="modal-header border-0 py-3" style="background-color: var(--bg-soft-mint);">
                <h6 class="modal-title mb-0 fw-bold text-dark">
                    <i class="fas fa-receipt me-2 text-primary"></i>Đơn hàng: <span id="detailModalId" class="text-primary"></span>
                </h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body p-0">
                <div class="px-4 py-2 border-bottom d-flex justify-content-between bg-white">
                    <span class="text-muted small">Ngày đặt hàng</span>
                    <span id="detailModalDate" class="fw-bold text-dark small"></span>
                </div>
                <div id="detailModalContent" class="px-4 py-2" style="max-height: 400px; overflow-y: auto;">
                </div>
            </div>

            <div class="modal-footer border-0 py-3 justify-content-center">
                <button type="button" class="btn btn-secondary rounded-pill btn-sm px-5" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="reviewModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title fw-bold"><i class="fas fa-star me-2"></i>Đánh giá sản phẩm</h5>
                <button type="button" class="btn-close btn-close-white" onclick="location.reload()"></button>
            </div>
            <div class="modal-body p-4 bg-light">
                <p class="text-center text-muted mb-4">Cảm ơn bạn đã mua hàng! Hãy chia sẻ cảm nhận về các cuốn sách bạn vừa nhận nhé.</p>
                <div id="reviewProductList">
                </div>
            </div>
            <div class="modal-footer bg-white border-0">
                <button type="button" class="btn btn-secondary rounded-pill px-4" onclick="location.reload()">Hoàn tất & Đóng</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/libold/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        $(document).ready(function () {

            // --- XỬ LÝ XEM CHI TIẾT ---
            $(".btn-view-detail").click(function() {
                var maDon = $(this).data("madon");
                var ngayDat = $(this).data("ngay");
                var htmlContent = $("#detail-data-" + maDon).html();
                $("#detailModalId").text(maDon);
                $("#detailModalDate").text(ngayDat);
                $("#detailModalContent").html(htmlContent);
                $("#detailModal").modal('show');
            });

            // --- XỬ LÝ HỦY ĐƠN ---
            var orderIdToCancel = "";
            $(".btn-cancel-trigger").click(function () {
                orderIdToCancel = $(this).data("madonhang");
                $("#cancelOrderIdDisplay").text(orderIdToCancel);
                $("#confirmCancelModal").modal('show');
            });

            $("#btnConfirmCancel").click(function() {
                $("#confirmCancelModal").modal('hide');
                $.ajax({
                    url: '@Url.Action("HuyDonHang", "KhachHang")',
                    type: 'POST',
                    data: { maDonHang: orderIdToCancel },
                    success: function (response) {
                        $("#infoModalBody").text(response.message);
                        $("#infoModal").modal('show');
                        if (response.success) {
                            setTimeout(function () { location.reload(); }, 1500);
                        }
                    },
                    error: function () {
                        $("#infoModalBody").text("Lỗi kết nối server.");
                        $("#infoModal").modal('show');
                    }
                });
            });

            // --- LƯU THÔNG TIN ---
            $(".btn-save-info").click(function () {
                var hoTen = $("#hoTen").val();
                var email = $("#email").val();
                var soDienThoai = $("#soDienThoai").val();
                var diaChi = $("#diaChi").val();

                if (!hoTen || !email) {
                    $("#infoModalBody").text("Vui lòng nhập họ tên và email.");
                    $("#infoModal").modal('show');
                    return;
                }

                var btn = $(this);
                var originalHtml = btn.html();
                btn.html('<i class="fas fa-spinner fa-spin"></i>').prop('disabled', true);

                $.ajax({
                    url: '@Url.Action("CapNhatThongTin", "KhachHang")',
                    type: 'POST',
                    data: { hoTen: hoTen, email: email, soDienThoai: soDienThoai, diaChi: diaChi },
                    success: function (response) {
                        $("#infoModalBody").text(response.message);
                        $("#infoModal").modal('show');
                        if (response.success) {
                            setTimeout(function () { location.reload(); }, 1500);
                        }
                        btn.html(originalHtml).prop('disabled', false);
                    },
                    error: function () {
                        $("#infoModalBody").text("Có lỗi xảy ra, vui lòng thử lại.");
                        $("#infoModal").modal('show');
                        btn.html(originalHtml).prop('disabled', false);
                    }
                });
            });

            // --- NHẬN HÀNG ---
                $(".btn-received-order").off('click').on('click', function () {
            var maDonHang = $(this).data("madonhang");
            var btn = $(this);
            var originalHtml = btn.html();

            if (confirm("Xác nhận bạn đã nhận hàng thành công? Hệ thống sẽ mở mục đánh giá ngay sau đó.")) {
                // Trạng thái loading trên nút bấm chính
                btn.html('<i class="fas fa-spinner fa-spin"></i> Đang xử lý...').prop('disabled', true);

                $.ajax({
                    url: '@Url.Action("XacNhanNhanHang", "KhachHang")',
                    type: 'POST',
                    data: { maDonHang: maDonHang },
                    success: function (response) {
                        if (response.success) {
                            // 1. Xây dựng nội dung HTML bằng cách cộng chuỗi (Tránh lỗi dấu backtick trong Razor)
                            var htmlContent = "";
                            if (response.products && response.products.length > 0) {
                                $.each(response.products, function(i, p) {
                                    htmlContent += '<div class="card mb-3 shadow-sm bg-white border border-light">' +
                                        '<div class="card-body p-3">' +
                                            '<div class="d-flex align-items-center mb-3">' +
                                                '<img src="/Images/' + p.anhBia + '" style="width: 55px; height: 75px; object-fit: cover;" class="me-3 border rounded shadow-sm">' +
                                                '<div>' +
                                                    '<h6 class="fw-bold mb-0 text-dark">' + p.tenSach + '</h6>' +
                                                    '<small class="text-muted small">Mã sách: ' + p.maSach + '</small>' +
                                                '</div>' +
                                            '</div>' +
                                            '<form class="quick-review-form" data-masach="' + p.maSach + '">' +
                                                '<div class="d-flex align-items-center justify-content-between mb-3">' +
                                                    '<span class="small text-muted fw-bold">Chất lượng sản phẩm:</span>' +
                                                    '<div class="star-rating-mini">' +
                                                        '<input type="radio" id="s5-' + p.maSach + '" name="rating-' + p.maSach + '" value="5" checked /><label for="s5-' + p.maSach + '" class="fas fa-star"></label>' +
                                                        '<input type="radio" id="s4-' + p.maSach + '" name="rating-' + p.maSach + '" value="4" /><label for="s4-' + p.maSach + '" class="fas fa-star"></label>' +
                                                        '<input type="radio" id="s3-' + p.maSach + '" name="rating-' + p.maSach + '" value="3" /><label for="s3-' + p.maSach + '" class="fas fa-star"></label>' +
                                                        '<input type="radio" id="s2-' + p.maSach + '" name="rating-' + p.maSach + '" value="2" /><label for="s2-' + p.maSach + '" class="fas fa-star"></label>' +
                                                        '<input type="radio" id="s1-' + p.maSach + '" name="rating-' + p.maSach + '" value="1" /><label for="s1-' + p.maSach + '" class="fas fa-star"></label>' +
                                                    '</div>' +
                                                '</div>' +
                                                '<div class="input-group">' +
                                                    '<textarea class="form-control border-light bg-light" placeholder="Viết cảm nhận của bạn về cuốn sách..." rows="2" style="resize:none; font-size: 0.9rem;"></textarea>' +
                                                    '<button type="button" class="btn btn-success btn-submit-review px-3">' +
                                                        '<i class="fas fa-paper-plane me-1"></i> Gửi' +
                                                    '</button>' +
                                                '</div>' +
                                            '</form>' +
                                        '</div>' +
                                    '</div>';
                                });
                            } else {
                                htmlContent = '<div class="alert alert-success border-0 shadow-sm">Đã cập nhật trạng thái đơn hàng. Không tìm thấy sản phẩm để đánh giá.</div>';
                            }

                            // 2. Đổ dữ liệu vào Modal và hiển thị
                            $("#reviewProductList").html(htmlContent);
                            var reviewModal = new bootstrap.Modal(document.getElementById('reviewModal'));
                            reviewModal.show();

                            // 3. Xử lý nút Gửi đánh giá cho từng sản phẩm
                            $(".btn-submit-review").on('click', function() {
                                var form = $(this).closest("form");
                                var maSach = form.data("masach");
                                var diem = form.find("input[type=radio]:checked").val();
                                var binhLuan = form.find("textarea").val();
                                var btnReview = $(this);
                                var btnIcon = btnReview.html();

                                btnReview.html('<i class="fas fa-spinner fa-spin"></i>').prop('disabled', true);

                                $.ajax({
                                    url: '@Url.Action("GuiDanhGia", "Home")',
                                    type: 'POST',
                                    data: {
                                        maSach: maSach,
                                        diem: diem,
                                        binhLuan: binhLuan,
                                        __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                                    },
                                    success: function(resRev) {
                                        if(resRev.success) {
                                            form.fadeOut(300, function() {
                                                $(this).html('<div class="text-center text-success py-3 fw-bold"><i class="fas fa-check-circle me-2"></i> Đánh giá thành công!</div>').fadeIn();
                                            });
                                        } else {
                                            alert(resRev.message);
                                            btnReview.html(btnIcon).prop('disabled', false);
                                        }
                                    },
                                    error: function() {
                                        alert("Lỗi khi gửi đánh giá. Vui lòng thử lại.");
                                        btnReview.html(btnIcon).prop('disabled', false);
                                    }
                                });
                            });

                        } else {
                            alert(response.message);
                            btn.html(originalHtml).prop('disabled', false);
                        }
                    },
                    error: function () {
                        alert("Lỗi kết nối server.");
                        btn.html(originalHtml).prop('disabled', false);
                    }
                });
            }
        });

            // --- NÚT SỬA ---
             $(".btn-edit-order").click(function() {
                $("#infoModalBody").text("Tính năng đang phát triển.");
                $("#infoModal").modal('show');
            });
        });
    </script>
}