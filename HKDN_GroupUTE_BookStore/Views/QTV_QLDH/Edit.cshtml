@model HKDN_GroupUTE_BookStore.Models.Donhang

@{
    ViewBag.Title = "Edit";
    Layout = "~/Views/Shared/_LayoutQuanTriVien.cshtml";
}

<style>
    /* Container chính cho toàn bộ nội dung */
    .edit-order-container-wrapper {
        display: flex;
        justify-content: center;
        align-items: flex-start;
        padding: 40px 20px;
        min-height: calc(100vh - 56px);
        color: #E2E8F0;
        margin-top: 30px;
    }

    /* Card chứa form */
    .form-card {
        background-color: #2D3748;
        padding: 40px;
        border-radius: 12px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.25);
        width: 100%;
        max-width: 800px;
        transition: transform 0.3s ease-in-out;
    }

        .form-card:hover {
            transform: translateY(-5px);
        }

        /* Tiêu đề trang */
        .form-card h2 {
            text-align: center;
            font-size: 2.2rem;
            font-weight: 700;
            color: #4FD1C5;
            margin-bottom: 25px;
            text-transform: uppercase;
            letter-spacing: 1.5px;
        }

        .form-card hr {
            border-color: #4A5568;
            margin-bottom: 30px;
        }

    /* Validation Summary */
    .validation-summary-errors {
        color: #EF4444;
        background-color: rgba(239, 68, 68, 0.1);
        border: 1px solid #EF4444;
        border-radius: 8px;
        padding: 15px;
        margin-bottom: 20px;
        font-size: 0.9rem;
        text-align: center;
    }

    /* Form Layout (Grid) */
    .form-horizontal {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 25px 30px;
    }

    .form-group {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    /* Labels */
    .control-label {
        font-size: 0.95rem;
        font-weight: 600;
        color: #E2E8F0;
        margin-bottom: 0;
    }

    /* Input/Editor fields và DropdownList */
    .form-control {
        width: 100%;
        padding: 12px 15px;
        border: 1px solid #4A5568;
        border-radius: 8px;
        font-size: 1rem;
        background-color: #2D3748;
        color: #FFFFFF;
    }

        .form-control:focus {
            outline: none;
            border-color: #4A5568;
            background-color: #2D3748;
        }

        /* Placeholder text */
        .form-control::placeholder {
            color: rgba(226, 232, 240, 0.5);
        }

    /* Validation messages for individual fields */
    .text-danger {
        color: #EF4444;
        font-size: 0.8rem;
        margin-top: 4px;
        font-weight: 500;
    }

    /* Submit button group */
    .form-group.submit-group {
        grid-column: 1 / -1;
        display: flex;
        justify-content: center;
        margin-top: 30px;
    }

    .btn-submit {
        padding: 14px 30px;
        background: linear-gradient(45deg, #4FD1C5, #38B2AC);
        border: none;
        color: #1A202C;
        font-size: 1.1rem;
        font-weight: 700;
        border-radius: 10px;
        cursor: pointer;
        transition: all 0.3s ease;
        box-shadow: 0 4px 15px rgba(79, 209, 197, 0.3);
    }

        .btn-submit:hover {
            background: linear-gradient(45deg, #38B2AC, #4FD1C5);
            transform: translateY(-3px);
            box-shadow: 0 6px 20px rgba(79, 209, 197, 0.4);
        }

        .btn-submit:active {
            transform: translateY(0);
            box-shadow: 0 2px 10px rgba(79, 209, 197, 0.2);
        }

    /* Back to List link */
    .back-link-container {
        text-align: center;
        margin-top: 25px;
    }

    .back-link {
        color: #63B3ED;
        text-decoration: none;
        font-weight: 600;
        transition: color 0.3s ease;
        padding: 10px 20px;
        display: inline-block;
    }

        .back-link:hover {
            color: #4299E1;
            text-decoration: underline;
        }
</style>

<div class="edit-order-container-wrapper">
    <div class="form-card">
        <h2>CHỈNH SỬA ĐƠN HÀNG</h2>
        <hr />

        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()

            <div class="form-horizontal">
                @Html.ValidationSummary(true, "", new { @class = "validation-summary-errors" })
                @Html.HiddenFor(model => model.MaDonHang)

                <div class="form-group">
                    <label class="control-label">Mã Người Dùng</label>
                    @Html.DropDownList("MaNguoiDung", null, "Chọn người dùng", new { @class = "form-control" })
                    @Html.ValidationMessageFor(model => model.MaNguoiDung, "", new { @class = "text-danger" })
                </div>

                <div class="form-group">
                    <label class="control-label">Tổng Tiền</label>
                    @Html.EditorFor(model => model.TongTien, new { htmlAttributes = new { @class = "form-control", placeholder = "Nhập tổng tiền", type = "number" } })
                    @Html.ValidationMessageFor(model => model.TongTien, "", new { @class = "text-danger" })
                </div>

                <div class="form-group">
                    <label class="control-label">Trạng Thái Đơn Hàng</label>

                    @Html.DropDownListFor(m => m.TrangThaiDonHang,
                             new List<SelectListItem>
                            {
                                new SelectListItem { Text = "Đang xử lý", Value = "DangXuLy", Selected = (Model.TrangThaiDonHang == "DangXuLy") },
                                new SelectListItem { Text = "Đã giao",     Value = "DaGiao",   Selected = (Model.TrangThaiDonHang == "DaGiao") },
                                new SelectListItem { Text = "Đã huỷ",      Value = "DaHuy",    Selected = (Model.TrangThaiDonHang == "DaHuy") },
                            },
                             "Chọn trạng thái",
                             new { @class = "form-control" }
                             )

                    @Html.ValidationMessageFor(m => m.TrangThaiDonHang, "", new { @class = "text-danger" })
                </div>


                <div class="form-group">
                    <label class="control-label">Địa Chỉ Giao</label>
                    @Html.EditorFor(model => model.DiaChiGiao, new { htmlAttributes = new { @class = "form-control", placeholder = "Nhập địa chỉ giao" } })
                    @Html.ValidationMessageFor(model => model.DiaChiGiao, "", new { @class = "text-danger" })
                </div>

                <div class="form-group">
                    <label class="control-label">Ngày Tạo</label>
                    @Html.EditorFor(model => model.NgayTao, new { htmlAttributes = new { @class = "form-control", type = "date" } })
                    @Html.ValidationMessageFor(model => model.NgayTao, "", new { @class = "text-danger" })
                </div>

                <div class="form-group submit-group">
                    <input type="submit" value="Lưu Thay Đổi" class="btn-submit" />
                </div>
            </div>
        }

        <div class="back-link-container">
            @Html.ActionLink("Quay lại danh sách", "Index", null, new { @class = "back-link" })
        </div>
    </div>
</div>