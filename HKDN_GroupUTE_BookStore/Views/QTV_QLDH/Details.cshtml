@model HKDN_GroupUTE_BookStore.Models.Donhang
@{
    ViewBag.Title = "Details";
    Layout = "~/Views/Shared/_LayoutQuanTriVien.cshtml";
}

<style>
    /* Container chính cho toàn bộ nội dung */
    .details-container-wrapper {
        display: flex;
        justify-content: center;
        align-items: flex-start;
        padding: 40px 20px;
        min-height: calc(100vh - 56px);
        color: #E2E8F0;
        margin-top: 30px;
    }

    /* Card chứa thông tin chi tiết */
    .details-card {
        background-color: #2D3748;
        padding: 40px;
        border-radius: 12px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.25);
        width: 100%;
        max-width: 800px;
        transition: transform 0.3s ease-in-out;
    }

        .details-card:hover {
            transform: translateY(-5px);
        }

        /* Tiêu đề trang */
        .details-card h2 {
            text-align: center;
            font-size: 2.2rem;
            font-weight: 700;
            color: #4FD1C5;
            margin-bottom: 25px;
            text-transform: uppercase;
            letter-spacing: 1.5px;
        }

        .details-card hr {
            border-color: #4A5568;
            margin-bottom: 30px;
        }

    /* Danh sách chi tiết */
    .details-list {
        display: grid;
        grid-template-columns: 50% 50%;
        gap: 15px 30px;
        margin-bottom: 30px;
    }

    .details-label {
        font-size: 1rem;
        font-weight: 600;
        color: #A0AEC0;
        text-align: left;
    }

    .details-value {
        font-size: 1rem;
        color: #E2E8F0;
        font-weight: 500;
    }

    /* Nhóm nút hành động */
    .details-actions-group {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 15px;
        margin-top: 30px;
        margin-bottom: 20px;
    }

    .action-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 10px 20px;
        border-radius: 8px;
        text-decoration: none;
        font-size: 0.95rem;
        font-weight: 600;
        transition: all 0.3s ease;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.15);
        border: none;
        color: #ffffff;
    }

        .action-button i {
            margin-right: 8px;
        }

        .action-button.edit {
            background-color: #FCD34D;
            color: #1A202C;
        }

            .action-button.edit:hover {
                background-color: #FBBF24;
                transform: translateY(-3px);
                box-shadow: 0 6px 15px rgba(0, 0, 0, 0.25);
            }

    .back-link {
        padding: 10px 20px;
        background: linear-gradient(45deg, #63B3ED, #4299E1);
        border: none;
        color: #FFFFFF;
        font-size: 0.95rem;
        font-weight: 600;
        border-radius: 8px;
        cursor: pointer;
        transition: all 0.3s ease;
        box-shadow: 0 4px 10px rgba(99, 179, 237, 0.15);
        text-decoration: none;
        display: inline-block;
    }

        .back-link:hover {
            background: linear-gradient(45deg, #4299E1, #63B3ED);
            transform: translateY(-3px);
            box-shadow: 0 6px 15px rgba(99, 179, 237, 0.25);
        }

    /* Styles cho bảng ChiTietDonHang */
    .chi-tiet-table-container {
        background-color: #1A202C; /* Darker background for table */
        border-radius: 8px;
        overflow-x: auto;
        margin-top: 30px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
    }

    .chi-tiet-table {
        width: 100%;
        border-collapse: collapse;
    }

        .chi-tiet-table th, .chi-tiet-table td {
            padding: 12px 15px;
            text-align: left;
            border-bottom: 1px solid #4A5568; /* Border color for rows */
        }

        .chi-tiet-table th {
            background-color: #2D3748; /* Header background */
            color: #4FD1C5; /* Header text color */
            font-weight: 600;
            font-size: 0.9rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .chi-tiet-table tbody tr:last-child td {
            border-bottom: none;
        }

        .chi-tiet-table tbody tr:hover {
            background-color: #242A36; /* Hover effect for rows */
        }

        .chi-tiet-table td {
            color: #E2E8F0; /* Cell text color */
            font-size: 0.95rem;
        }

    .no-details-message {
        text-align: center;
        padding: 20px;
        color: #A0AEC0;
        font-style: italic;
        font-size: 1rem;
    }
</style>

<div class="details-container-wrapper">
    <div class="details-card">
        <h2>CHI TIẾT ĐƠN HÀNG</h2>
        <hr />
        <dl class="details-list">
            <dt class="details-label">Mã Đơn Hàng</dt>
            <dd class="details-value">@Html.DisplayFor(model => model.MaDonHang)</dd>

            <dt class="details-label">Mã Người Dùng</dt>
            <dd class="details-value">@Html.DisplayFor(model => model.MaNguoiDung)</dd>

            <dt class="details-label">Họ Tên Người Dùng</dt>
            <dd class="details-value">@Html.DisplayFor(model => model.MaNguoiDungNavigation.HoTen)</dd>

            <dt class="details-label">Tổng Tiền</dt>
            <dd class="details-value">@Model.TongTien.ToString("N0")</dd>

            <dt class="details-label">Trạng Thái Đơn Hàng</dt>
            <dd class="details-value">@Html.DisplayFor(model => model.TrangThaiDonHang)</dd>

            <dt class="details-label">Địa Chỉ Giao</dt>
            <dd class="details-value">@Html.DisplayFor(model => model.DiaChiGiao)</dd>

            <dt class="details-label">Ngày Tạo</dt>
            <dd class="details-value">@Html.DisplayFor(model => model.NgayTao)</dd>
        </dl>

        <h3 class="text-xl font-semibold mb-3 text-indigo-700">Chi Tiết Các Mặt Hàng</h3>
        <hr class="my-4 border-gray-300" />

        @if (Model.Chitietdonhangs != null && Model.Chitietdonhangs.Any())
        {
            <div class="chi-tiet-table-container">
                <table class="chi-tiet-table">
                    <thead>
                        <tr>
                            <th>Mã Chi Tiết</th>
                            <th>Mã Sách</th>
                            <th>Tên Sách</th> @* Hiển thị Tên Sách nếu đã Include Sach *@
                            <th>Số Lượng</th>
                            <th>Giá Bán</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Chitietdonhangs)
                        {
                            <tr>
                                <td>@Html.DisplayFor(modelItem => item.MaChiTiet)</td>
                                <td>@Html.DisplayFor(modelItem => item.MaSach)</td>
                                <td>@Html.DisplayFor(modelItem => item.MaSachNavigation.TenSach)</td>
                                <td>@Html.DisplayFor(modelItem => item.SoLuong)</td>
                                <td>@item.GiaBan.ToString("N0")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <p class="no-details-message">Không có chi tiết mặt hàng nào cho đơn hàng này.</p>
        }

        <div class="details-actions-group">
            <a href="@Url.Action("Edit", new { id = Model.MaDonHang })" class="action-button edit" title="Sửa">
                <i class="fas fa-edit"></i> Sửa
            </a>
            <a href="@Url.Action("Index")" class="back-link" title="Quay lại danh sách">
                <i class="fas fa-arrow-left"></i> Quay lại danh sách
            </a>
        </div>
    </div>
</div>