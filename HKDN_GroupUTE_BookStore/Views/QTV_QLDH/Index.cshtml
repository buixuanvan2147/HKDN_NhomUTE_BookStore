@model IEnumerable<HKDN_GroupUTE_BookStore.Models.Donhang>

@{
    ViewBag.Title = "Quản Lý Đơn Hàng";
    Layout = "~/Views/Shared/_LayoutQuanTriVien.cshtml";

    var thongKe = ViewBag.DoanhThuThongKe as HKDN_GroupUTE_BookStore.ViewModel.QTV_DoanhThuViewModel;
    int index = 1;
}

<style>
    /* --- CSS CŨ (GIỮ NGUYÊN) --- */
    .order-list-container { padding: 60px 2vw 30px 2vw; color: #E2E8F0; min-height: calc(100vh - 56px); box-sizing: border-box; background-color: #1A202C; }
    .page-title { text-align: center; font-size: clamp(1.8rem, 5vw, 2.2rem); font-weight: 700; color: #4FD1C5; margin-bottom: 30px; text-transform: uppercase; letter-spacing: 1.5px; }
    
    /* --- [ĐÃ SỬA] Thống kê: Xếp gọn trên 1 hàng --- */
    .stats-cards-container { 
        display: flex;                 /* Sử dụng Flexbox để xếp hàng ngang */
        flex-wrap: nowrap;             /* Không cho phép xuống dòng */
        gap: 15px;                     /* Khoảng cách giữa các thẻ */
        margin-bottom: 40px;
        overflow-x: auto;              /* Hiện thanh cuộn ngang nếu màn hình quá nhỏ */
        padding-bottom: 10px;          /* Khoảng đệm cho thanh cuộn */
    }

    .stat-card { 
        flex: 1;                       /* Các thẻ chia đều chiều rộng */
        min-width: 180px;              /* Đảm bảo thẻ không bị co quá nhỏ */
        background-color: #2D3748; 
        border-radius: 12px; 
        padding: 20px 15px;            /* Padding gọn hơn */
        text-align: center; 
        border: 1px solid #4A5568; 
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1); 
        white-space: nowrap;           /* Giữ nội dung trên 1 dòng */
    }

    .stat-card h3 { 
        color: #A0AEC0; 
        font-size: 1rem;               /* Chữ tiêu đề nhỏ lại xíu cho cân đối */
        margin-bottom: 10px; 
    }
    
    .stat-card .value { 
        font-size: 1.8rem;             /* Giảm size số liệu một chút */
        font-weight: 700; 
        color: #4FD1C5; 
    }
    
    .stat-card .sub-value { 
        color: #E2E8F0; 
        font-size: 0.85rem; 
        margin-top: 5px; 
    }

    /* Bảng */
    .table-responsive { overflow-x: auto; }
    .table-custom { width: 100%; border-collapse: separate; border-spacing: 0; background-color: #2D3748; border-radius: 12px; overflow: hidden; border: 1px solid #4A5568; }
    .table-custom thead { background-color: #1A202C; color: #4FD1C5; }
    .table-custom thead th { padding: 15px; text-align: center; border-bottom: 1px solid #4A5568; font-weight: 600; white-space: nowrap; }
    .table-custom tbody td { padding: 12px 10px; border-bottom: 1px solid #4A5568; font-size: 0.9rem; color: #E2E8F0; vertical-align: middle; text-align: center; }
    .col-address { text-align: left !important; white-space: normal; word-wrap: break-word; max-width: 250px; }
    .table-custom tbody tr:hover { background-color: #2d3748; }

    /* Badge & Button */
    .status-badge { min-width: 120px;  padding: 6px 12px; border-radius: 30px; font-size: 0.8rem; font-weight: 600; display: inline-block; white-space: nowrap; }
    .st-ChoXacNhan { background-color: #4A5568; color: #E2E8F0; }
    .st-DangXuLy { background-color: #F6E05E; color: #1A202C; }
    .st-DangGiao { background-color: #4299E1; color: white; }
    .st-DaGiao { background-color: #48BB78; color: white; }
    .st-DaHuy { background-color: #F56565; color: white; }

    .action-buttons-group { display: flex; justify-content: center; align-items: center; gap: 8px; height: 100%; }
    .action-button { display: inline-flex; align-items: center; justify-content: center; padding: 0 12px; height: 34px; border-radius: 6px; border: none; color: white; font-size: 0.8rem; font-weight: 600; cursor: pointer; text-decoration: none; transition: all 0.2s; white-space: nowrap; }
    .action-button:hover { opacity: 0.9; transform: translateY(-1px); color: white; }
    .btn-details { background-color: #3182CE; }
    .btn-confirm { background-color: #38A169; }
    .btn-ship { background-color: #D69E2E; color: white; }
    .btn-delete { background-color: #E53E3E; }
    .btn-confirm i, .btn-ship i { margin-right: 5px; }

    /* --- CSS CHO POPUP CONFIRM --- */
    .custom-modal-overlay {
        display: none; /* Mặc định ẩn */
        position: fixed; top: 0; left: 0; width: 100%; height: 100%;
        background-color: rgba(0, 0, 0, 0.7); /* Nền đen mờ */
        z-index: 9999;
        justify-content: center; align-items: center;
        backdrop-filter: blur(4px); /* Hiệu ứng mờ đục */
        animation: fadeIn 0.2s ease-out;
    }

    .custom-modal-box {
        background-color: #2D3748;
        border: 1px solid #4A5568;
        border-radius: 12px;
        padding: 30px;
        width: 90%; max-width: 400px;
        text-align: center;
        box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.5);
        transform: scale(0.95);
        animation: scaleUp 0.2s ease-out forwards;
    }

    .modal-icon { font-size: 3rem; color: #4FD1C5; margin-bottom: 15px; }
    .modal-title { font-size: 1.25rem; font-weight: bold; color: white; margin-bottom: 10px; }
    .modal-desc { color: #A0AEC0; margin-bottom: 25px; font-size: 0.95rem; line-height: 1.5; }

    .modal-actions { display: flex; justify-content: center; gap: 15px; }
    .btn-modal { padding: 10px 24px; border-radius: 8px; font-weight: 600; border: none; cursor: pointer; transition: all 0.2s; }
    .btn-yes { background-color: #38A169; color: white; }
    .btn-yes:hover { background-color: #2F855A; }
    .btn-no { background-color: #4A5568; color: white; }
    .btn-no:hover { background-color: #718096; }

    /* Media queries cho màn hình nhỏ hơn */
    @@media (max-width: 768px) {
        .order-list-container {
            padding: 40px 1vw 20px 1vw;
        }

        .page-title {
            font-size: 1.5rem;
            margin-bottom: 20px;
        }

        .stats-cards-container {
            grid-template-columns: 1fr; /* Một cột trên màn hình nhỏ */
            gap: 15px;
            margin-bottom: 30px;
        }

        .stat-card {
            padding: 20px;
        }

            .stat-card h3 {
                font-size: 1.1rem;
            }

            .stat-card .value {
                font-size: 2rem;
            }

            .stat-card .sub-value {
                font-size: 0.9rem;
            }

        .add-new-button {
            padding: 10px 20px;
            font-size: 0.9rem;
        }

        .table-custom thead th,
        .table-custom tbody td {
            padding: 10px 0.8vw;
            font-size: 0.85rem;
        }

        .action-button {
            padding: 6px 10px;
            font-size: 0.7rem;
        }

        .action-buttons-group {
            gap: 5px;
        }
    }
    /* Style cho thanh tìm kiếm đơn hàng */
    .search-filter-wrapper {
        background-color: #2D3748;
        padding: 20px;
        border-radius: 12px;
        margin-bottom: 25px;
        border: 1px solid #4A5568;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
    }

    .search-form {
        display: flex;
        flex-wrap: wrap;
        gap: 15px;
        align-items: center;
    }

    .filter-group {
        flex: 1;
        min-width: 200px;
    }

        .filter-group input, .filter-group select {
            width: 100%;
            padding: 10px 15px;
            background-color: #1A202C;
            border: 1px solid #4A5568;
            color: #E2E8F0;
            border-radius: 8px;
            outline: none;
            transition: border-color 0.3s;
        }

            .filter-group input:focus, .filter-group select:focus {
                border-color: #4FD1C5;
            }

    .btn-search-action {
        padding: 10px 25px;
        background-color: #4FD1C5;
        color: #1A202C;
        border: none;
        border-radius: 8px;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.3s;
    }

        .btn-search-action:hover {
            background-color: #38B2AC;
            transform: translateY(-2px);
        }

    .btn-reset-filter {
        color: #A0AEC0;
        text-decoration: none;
        font-size: 0.9rem;
        padding: 10px;
    }
</style>

<div class="order-list-container">
    <h2 class="page-title">QUẢN LÝ ĐƠN HÀNG</h2>

    @if (thongKe != null) {
        <div class="stats-cards-container">
        <div class="stat-card">
            <h3>Chờ xác nhận</h3>
            <div class="value">@thongKe.SoLuongChoXacNhan</div>
            <div class="sub-value">
                @thongKe.TongTienChoXacNhan.ToString("N0")₫
            </div>
        </div>
        <div class="stat-card">
            <h3>Đang xử lý</h3>
            <div class="value">@thongKe.SoLuongDangXuLy</div>
            <div class="sub-value">
                @thongKe.TongTienDangXuLy.ToString("N0")₫
            </div>
        </div>
        <div class="stat-card">
            <h3>Đang giao</h3>
            <div class="value">@thongKe.SoLuongDangGiao</div>
            <div class="sub-value">
                @thongKe.TongTienDangGiao.ToString("N0")₫
            </div>
        </div>
        <div class="stat-card stat-card-success">
            <h3>Đã giao</h3>
            <div class="value">@thongKe.SoLuongDaGiao</div>
            <div class="sub-value">
                @thongKe.TongTienDaGiao.ToString("N0")₫
            </div>
        </div>
        <div class="stat-card stat-card-danger">
            <h3>Đã hủy</h3>
            <div class="value">@thongKe.SoLuongDaHuy</div>
            <div class="sub-value">
                @thongKe.TongTienDaHuy.ToString("N0")₫
            </div>
        </div>
    </div>
    }

    <div class="search-filter-wrapper">
        <form action="@Url.Action("Index", "QTV_QLDH")" method="get" class="search-form">
            <div class="filter-group">
                <input type="text" name="searchString" placeholder="Mã đơn hoặc tên khách hàng..." value="@ViewBag.CurrentSearch">
            </div>
            <div class="filter-group" style="max-width: 250px;">
                <select name="statusFilter">
                    <option value="">-- Tất cả trạng thái --</option>
                    <option value="ChoXacNhan" selected="@(ViewBag.CurrentStatus == "ChoXacNhan")">Chờ xác nhận</option>
                    <option value="DangXuLy" selected="@(ViewBag.CurrentStatus == "DangXuLy")">Đang xử lý</option>
                    <option value="DangGiao" selected="@(ViewBag.CurrentStatus == "DangGiao")">Đang giao</option>
                    <option value="DaGiao" selected="@(ViewBag.CurrentStatus == "DaGiao")">Đã giao</option>
                    <option value="DaHuy" selected="@(ViewBag.CurrentStatus == "DaHuy")">Đã hủy</option>
                </select>
            </div>
            <button type="submit" class="btn-search-action">
                <i class="fas fa-filter"></i> LỌC
            </button>
            <a href="@Url.Action("Index", "QTV_QLDH")" class="btn-reset-filter">Làm mới</a>
        </form>
    </div>

    @* Bạn có thể bỏ comment phần này nếu bạn muốn hiển thị nút tạo đơn hàng mới *@
    @*<div class="add-new-button-container">
            <a href="@Url.Action("Create")" class="add-new-button">
                <i class="fas fa-plus-circle"></i> Tạo Đơn Hàng Mới
            </a>
        </div>*@

    <div class="table-responsive">
        <table class="table-custom">
            <thead>
                <tr>
                    <th style="width: 50px">STT</th>
                    <th>Mã ĐH</th>
                    <th>Khách Hàng</th>
                    <th style="width: 25%">Địa Chỉ Giao</th>
                    <th>Ngày Tạo</th>
                    <th>Tổng Tiền</th>
                    <th>Trạng Thái</th>
                    <th colspan="2" style="width: 200px">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null)
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td>@(index++)</td>
                            <td style="font-weight:bold; color:#4FD1C5">@item.MaDonHang</td>
                            <td>@item.MaNguoiDungNavigation?.HoTen</td>
                            <td class="col-address">@item.DiaChiGiao</td>
                            <td>@(item.NgayTao.HasValue ? item.NgayTao.Value.ToString("dd/MM/yyyy HH:mm") : "---")</td>
                            <td style="font-weight:600">@item.TongTien.ToString("N0")₫</td>
                            <td>
                                <span class="status-badge st-@item.TrangThaiDonHang">
                                    @(item.TrangThaiDonHang switch {
                                        "ChoXacNhan" => "Chờ xác nhận",
                                        "DangXuLy" => "Đang xử lý",
                                        "DangGiao" => "Đang giao hàng",
                                        "DaGiao" => "Đã giao",
                                        "DaHuy" => "Đã hủy",
                                        _ => item.TrangThaiDonHang
                                    })
                                </span>
                            </td>
                            <td>
                                <a href="@Url.Action("Details", new { id = item.MaDonHang })" class="action-button btn-details" title="Xem chi tiết">
                                    <i class="fas fa-eye"></i> Chi tiết
                                </a>
                            </td>
                            <td>
                                <div class="action-buttons-group">
                                    @if (item.TrangThaiDonHang == "ChoXacNhan")
                                    {
                                        <button onclick="askConfirmation('@item.MaDonHang', 'DangXuLy', 'Xác nhận đơn hàng này?')" class="action-button btn-confirm">
                                            <i class="fas fa-check"></i> Xác nhận
                                        </button>
                                    }
                                    else if (item.TrangThaiDonHang == "DangXuLy")
                                    {
                                        <button onclick="askConfirmation('@item.MaDonHang', 'DangGiao', 'Chuyển đơn hàng sang giao hàng?')" class="action-button btn-ship">
                                            <i class="fas fa-shipping-fast"></i> Giao hàng
                                        </button>
                                    }

                                    @if (item.TrangThaiDonHang == "DaGiao" || item.TrangThaiDonHang == "DaHuy")
                                    {
                                        <a href="@Url.Action("Delete", new { id = item.MaDonHang })" class="action-button btn-delete" 
                                           onclick="return confirm('Bạn có chắc chắn muốn xóa đơn hàng này vĩnh viễn?')" title="Xóa">
                                            <i class="fas fa-trash"></i>
                                        </a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<div id="confirmModal" class="custom-modal-overlay">
    <div class="custom-modal-box">
        <div class="modal-icon">
            <i class="fas fa-question-circle"></i>
        </div>
        <h3 class="modal-title">Xác Nhận Thay Đổi</h3>
        <p class="modal-desc" id="modalMessage">Bạn có chắc chắn muốn thực hiện?</p>
        
        <div class="modal-actions">
            <button onclick="performUpdate()" class="btn-modal btn-yes">Đồng Ý</button>
            <button onclick="closeModal()" class="btn-modal btn-no">Hủy Bỏ</button>
        </div>
    </div>
</div>

<script>
    // Biến toàn cục lưu trạng thái tạm
    let pendingOrderId = "";
    let pendingNewStatus = "";

    // 1. Hàm mở Popup
    function askConfirmation(orderId, newStatus, message) {
        pendingOrderId = orderId;
        pendingNewStatus = newStatus;
        
        // Cập nhật nội dung thông báo
        document.getElementById('modalMessage').innerText = message;
        
        // Hiện Popup
        document.getElementById('confirmModal').style.display = 'flex';
    }

    // 2. Hàm đóng Popup
    function closeModal() {
        document.getElementById('confirmModal').style.display = 'none';
        pendingOrderId = "";
        pendingNewStatus = "";
    }

    // 3. Hàm thực hiện Update khi bấm Đồng Ý
    function performUpdate() {
        if (!pendingOrderId) return;

        // Thay đổi nút bấm để báo hiệu đang xử lý
        const btnYes = document.querySelector('.btn-yes');
        const originalText = btnYes.innerText;
        btnYes.innerText = "Đang xử lý...";
        btnYes.disabled = true;

        fetch('/QTV_QLDH/CapNhatTrangThaiAjax', {
            method: 'POST',
            headers: {
                // SỬ DỤNG Form-UrlEncoded ĐỂ TRÁNH LỖI "KHÔNG TÌM THẤY ĐƠN HÀNG" TRÊN MỘT SỐ CẤU HÌNH SERVER
                'Content-Type': 'application/x-www-form-urlencoded',
            },
            body: `id=${encodeURIComponent(pendingOrderId)}&trangThaiMoi=${encodeURIComponent(pendingNewStatus)}`
        })
        .then(res => res.json())
        .then(data => {
            if (data.success) {
                location.reload(); // Tải lại trang
            } else {
                alert("Lỗi: " + data.msg);
                closeModal();
            }
        })
        .catch(err => {
            console.error(err);
            alert("Lỗi kết nối!");
            closeModal();
        })
        .finally(() => {
            // Khôi phục nút bấm (phòng trường hợp lỗi không reload)
            btnYes.innerText = originalText;
            btnYes.disabled = false;
        });
    }

    // Đóng popup khi click ra ngoài
    window.onclick = function(event) {
        const modal = document.getElementById('confirmModal');
        if (event.target == modal) {
            closeModal();
        }
    }
</script>