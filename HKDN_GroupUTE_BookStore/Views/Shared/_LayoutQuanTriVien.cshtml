@using Microsoft.AspNetCore.Mvc.Razor
@functions {
    public string IsActive(string controller, string action = null)
    {
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
        var currentAction = ViewContext.RouteData.Values["action"]?.ToString();

        bool matchController = string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase);
        if (string.IsNullOrEmpty(action))
            return matchController ? "selected" : "";

        bool matchAction = string.Equals(currentAction, action, StringComparison.OrdinalIgnoreCase);
        return matchController && matchAction ? "selected" : "";
    }
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Quản Trị Viên</title>

    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: { inter: ['Inter', 'sans-serif'] },
                    colors: {
                        darkprimary: '#1A202C',
                        darksecondary: '#2D3748',
                        darkhover: '#4A5568',
                        darkactive: '#63B3ED',
                        darkaccent: '#4FD1C5',
                    }
                }
            }
        }
    </script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">

    <style>
        body {
            font-family: 'Inter', sans-serif;
            margin: 0;
            padding: 0;
            background-color: #1A202C;
            color: #e2e8f0;
        }

        /* Layout chính */
        .dashboard-wrapper {
            display: flex;
            min-height: 100vh;
        }

        /* Sidebar cố định */
        #sidebar {
            width: 280px;
            background-color: #1A202C;
            color: white;
            position: fixed;
            left: 0;
            top: 0;
            bottom: 0;
            overflow-y: auto;
            box-shadow: 4px 0 12px rgba(0, 0, 0, 0.3);
            transition: transform 0.3s ease;
            z-index: 40;
            padding: 1rem;
        }

        #sidebar.open {
            transform: translateX(0);
        }

        }

        /* Thanh cuộn đẹp */
        #sidebar::-webkit-scrollbar {
            width: 8px;
        }

        #sidebar::-webkit-scrollbar-track {
            background: #2D3748;
            border-radius: 10px;
        }

        #sidebar::-webkit-scrollbar-thumb {
            background: #4A5568;
            border-radius: 10px;
        }

            #sidebar::-webkit-scrollbar-thumb:hover {
                background: #4FD1C5;
            }

        /* Main content chiếm hết phần còn lại */
        .main-content {
            flex: 1;
            margin-left: 280px; /* Đúng bằng width sidebar */
            background: linear-gradient(to bottom, #0f172a, #1e293b);
            min-height: 100vh;
        }

        /* Menu item */
        .menu-item {
            display: flex;
            align-items: center;
            padding: 0.75rem 1rem;
            border-radius: 0.75rem;
            transition: all 0.2s ease;
            color: white;
            font-weight: 500;
        }

            .menu-item:hover {
                background-color: #4A5568;
                transform: translateX(4px);
            }

            .menu-item.selected {
                background-color: #63B3ED;
                font-weight: 600;
            }

            .menu-item i {
                width: 24px;
                margin-right: 12px;
                font-size: 1.2rem;
            }

        /* Nút đăng xuất */
        .menu-logout:hover {
            background-color: #EF4444 !important;
        }
    </style>
</head>
<body>
    <div class="dashboard-wrapper">
        <!-- Sidebar -->
        <aside id="sidebar" class="flex flex-col">
            <div class="flex items-center justify-center h-16 border-b border-gray-700 mb-6">
                <span class="text-2xl font-bold text-darkaccent">ADMIN DASHBOARD</span>
            </div>

            <nav class="flex-grow">
                <ul class="space-y-3">
                    <li>
                        <a href="@Url.Action("TrangChu_QuanTriVien", "QuanTriVien")"
                           class="menu-item @IsActive("QuanTriVien", "TrangChu_QuanTriVien")">
                            <i class="fas fa-home"></i>
                            <span>Trang chủ</span>
                        </a>
                    </li>
                    <li>
                        <a href="@Url.Action("QuanLySanPham_QuanTriVien", "QuanTriVien")"
                           class="menu-item @IsActive("QuanTriVien", "QuanLySanPham_QuanTriVien")">
                            <i class="fas fa-box"></i>
                            <span>Quản lý sản phẩm</span>
                        </a>
                    </li>
                    <li>
                        <a href="@Url.Action("Index", "QTV_QLND")"
                           class="menu-item @IsActive("QTV_QLND", "Index")">
                            <i class="fas fa-users"></i>
                            <span>Quản lý người dùng</span>
                        </a>
                    </li>
                    <li>
                        <a href="@Url.Action("Index", "QTV_QLDH")"
                           class="menu-item @IsActive("QTV_QLDH", "Index")">
                            <i class="fas fa-shopping-cart"></i>
                            <span>Quản lý đơn hàng</span>
                        </a>
                    </li>
                    <li>
                        <a href="@Url.Action("Index_Home", "Home")"
                           class="menu-item menu-logout">
                            <i class="fas fa-sign-out-alt text-red-500"></i>
                            <span>Về trang người dùng</span>
                        </a>
                    </li>
                </ul>
            </nav>
        </aside>

        <!-- Nút mở sidebar trên mobile -->
        <button id="mobileMenuBtn" class="fixed top-4 left-4 z-50 md:hidden p-3 rounded-lg bg-darksecondary text-white shadow-lg">
            <i class="fas fa-bars text-xl"></i>
        </button>

        <!-- Main content -->
        <main class="main-content">
            @RenderBody()
        </main>
    </div>

    @RenderSection("scripts", required: false)

    <script>
        const sidebar = document.getElementById('sidebar');
        const mobileBtn = document.getElementById('mobileMenuBtn');

        mobileBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            sidebar.classList.toggle('open');
        });

        // Đóng sidebar khi click ngoài trên mobile
        document.addEventListener('click', (e) => {
            if (window.innerWidth < 768 && sidebar.classList.contains('open')) {
                if (!sidebar.contains(e.target) && !mobileBtn.contains(e.target)) {
                    sidebar.classList.remove('open');
                }
            }
        });

        // Đảm bảo sidebar luôn mở trên desktop
        window.addEventListener('resize', () => {
            if (window.innerWidth >= 768) {
                sidebar.classList.remove('open');
            }
        });
    </script>
</body>
</html>