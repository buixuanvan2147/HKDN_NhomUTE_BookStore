@model HKDN_GroupUTE_BookStore.Models.Nguoidung

@{
    ViewBag.Title = "Details";
    Layout = "~/Views/Shared/_LayoutQuanTriVien.cshtml";
}

<style>
    /* Container chính cho toàn bộ nội dung */
    .details-container-wrapper { /* Đổi tên class để tránh trùng lặp */
        display: flex;
        justify-content: center;
        align-items: flex-start; /* Căn trên thay vì căn giữa tuyệt đối */
        padding: 40px 20px;
        min-height: calc(100vh - 56px); /* Đảm bảo đủ chiều cao */
        color: #E2E8F0; /* Màu chữ sáng */
        margin-top:30px;
    }

    /* Card chứa thông tin chi tiết */
    .details-card { /* Tái sử dụng class form-card từ các view khác */
        background-color: #2D3748; /* Màu nền phụ tối */
        padding: 40px;
        border-radius: 12px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.25);
        width: 100%;
        max-width: 800px; /* Giới hạn chiều rộng tối đa của card */
        transition: transform 0.3s ease-in-out;
    }

    .details-card:hover {
        transform: translateY(-5px);
    }

    /* Tiêu đề trang */
    .details-card h2 {
        text-align: center;
        font-size: 2.2rem;
        font-weight: 700;
        color: #4FD1C5; /* Màu nhấn */
        margin-bottom: 25px;
        text-transform: uppercase;
        letter-spacing: 1.5px;
    }

    .details-card hr {
        border-color: #4A5568; /* Màu đường kẻ ngang */
        margin-bottom: 30px;
    }

    /* Danh sách chi tiết (thay thế dl-horizontal) */
    .details-list {
        display: grid;
        grid-template-columns: 50% 50%; /* Cột label tự động chiều rộng, cột giá trị chiếm phần còn lại */
        gap: 15px 30px; /* Khoảng cách giữa các hàng và cột */
        margin-bottom: 30px;
    }

    .details-label {
        font-size: 1rem;
        font-weight: 600;
        color: #A0AEC0; /* Màu xám nhạt cho label */
        text-align: left; /* Căn trái label */
    }

    .details-value {
        font-size: 1rem;
        color: #E2E8F0; /* Màu chữ sáng cho giá trị */
        font-weight: 500;
    }

    /* Nhóm nút hành động */
    .details-actions-group { /* Đổi tên class để rõ ràng hơn */
        display: flex;
        justify-content: center; /* Căn giữa các nút */
        align-items: center;
        gap: 15px; /* Khoảng cách giữa các nút */
        margin-top: 30px;
        margin-bottom: 20px; /* Khoảng cách với link quay lại */
    }

    .action-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 10px 20px;
        border-radius: 8px;
        text-decoration: none;
        font-size: 0.95rem;
        font-weight: 600;
        transition: all 0.3s ease;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.15);
        border: none;
        color: #ffffff;
    }

    .action-button i {
        margin-right: 8px;
    }

    /* Màu cho từng loại nút hành động */
    .action-button.edit { /* Nút Sửa */
        background-color: #FCD34D; /* Vàng */
        color: #1A202C; /* Chữ tối */
    }
    .action-button.edit:hover {
        background-color: #FBBF24;
        transform: translateY(-3px);
        box-shadow: 0 6px 15px rgba(0, 0, 0, 0.25);
    }

    /* Link quay lại danh sách */
    .back-link {
        padding: 10px 20px; /* Thêm padding cho link để trông giống nút */
        background: linear-gradient(45deg, #63B3ED, #4299E1); /* Màu xanh dương cho link */
        border: none;
        color: #FFFFFF; /* Chữ trắng */
        font-size: 0.95rem;
        font-weight: 600;
        border-radius: 8px;
        cursor: pointer;
        transition: all 0.3s ease;
        box-shadow: 0 4px 10px rgba(99, 179, 237, 0.15);
        text-decoration: none; /* Bỏ gạch chân mặc định */
        display: inline-block; /* Để padding và margin hoạt động */
    }

    .back-link:hover {
        background: linear-gradient(45deg, #4299E1, #63B3ED);
        transform: translateY(-3px);
        box-shadow: 0 6px 15px rgba(99, 179, 237, 0.25);
    }

    /* Responsive adjustments */
    @@media (max-width: 768px) {
        .details-card {
            padding: 30px;
            border-radius: 8px;
        }

        .details-card h2 {
            font-size: 1.8rem;
            margin-bottom: 20px;
        }

        .details-list {
            grid-template-columns: 1fr; /* Một cột trên mobile */
            gap: 15px;
        }

        .details-label {
            text-align: left; /* Căn trái label trên mobile */
            padding-right: 0;
            font-size: 0.9rem;
        }

        .details-value {
            font-size: 0.9rem;
        }

        .details-actions-group {
            flex-direction: column; /* Xếp nút dọc trên mobile */
            gap: 10px;
        }

        .action-button, .back-link {
            width: 100%; /* Nút chiếm toàn bộ chiều rộng */
            padding: 12px 20px;
            font-size: 0.9rem;
        }
    }

    @@media (max-width: 480px) {
        .details-card {
            padding: 20px;
        }

        .details-card h2 {
            font-size: 1.5rem;
        }
    }
</style>

<div class="details-container-wrapper">
    <div class="details-card">
        <h2>XEM CHI TIẾT NGƯỜI DÙNG</h2>

        <hr />
        <dl class="details-list">
            <dt class="details-label">
                Họ Tên
            </dt>
            <dd class="details-value">
                @Html.DisplayFor(model => model.HoTen)
            </dd>

            <dt class="details-label">
                Email
            </dt>
            <dd class="details-value">
                @Html.DisplayFor(model => model.Email)
            </dd>

            <dt class="details-label">
                Mật Khẩu
            </dt>
            <dd class="details-value">
                @Html.DisplayFor(model => model.MatKhau)
            </dd>

            <dt class="details-label">
                Số Điện Thoại
            </dt>
            <dd class="details-value">
                @Html.DisplayFor(model => model.SoDienThoai)
            </dd>

            <dt class="details-label">
                Địa Chỉ
            </dt>
            <dd class="details-value">
                @Html.DisplayFor(model => model.DiaChi)
            </dd>

            <dt class="details-label">
                Vai Trò
            </dt>
            <dd class="details-value">
                @Html.DisplayFor(model => model.VaiTro)
            </dd>

            <dt class="details-label">
                Ngày Tạo
            </dt>
            <dd class="details-value">
                @Html.DisplayFor(model => model.NgayTao)
            </dd>
        </dl>

        <div class="details-actions-group">
            <a href="@Url.Action("Edit", new { id = Model.MaNguoiDung })" class="action-button edit" title="Sửa">
                <i class="fas fa-edit"></i> Sửa
            </a>
            <a href="@Url.Action("Index")" class="back-link" title="Quay lại danh sách">
                <i class="fas fa-arrow-left"></i> Quay lại danh sách
            </a>
        </div>
    </div>
</div>
