@model HKDN_GroupUTE_BookStore.Models.Sach

@{
    ViewBag.Title = "Edit";
    Layout = "~/Views/Shared/_LayoutQuanTriVien.cshtml";
}

<style>
    /* Container chính cho toàn bộ nội dung */
    .edit-book-container-wrapper { /* Đổi tên class để tránh trùng lặp */
        display: flex;
        justify-content: center;
        align-items: flex-start; /* Căn trên thay vì căn giữa tuyệt đối */
        padding: 40px 20px;
        min-height: calc(100vh - 56px); /* Đảm bảo đủ chiều cao */
        background-color: #1A202C; /* Nền tối của layout chính */
        color: #E2E8F0; /* Màu chữ sáng */
    }

    /* Card chứa form */
    .form-card { /* Tái sử dụng class form-card từ các view khác */
        background-color: #2D3748; /* Màu nền phụ tối */
        padding: 40px;
        border-radius: 12px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.25);
        width: 100%;
        max-width: 800px; /* Giới hạn chiều rộng tối đa của form */
        transition: transform 0.3s ease-in-out;
    }

    .form-card:hover {
        transform: translateY(-5px);
    }

    /* Tiêu đề trang */
    .form-card h2 {
        text-align: center;
        font-size: 2.2rem;
        font-weight: 700;
        color: #4FD1C5; /* Màu nhấn */
        margin-bottom: 25px;
        text-transform: uppercase;
        letter-spacing: 1.5px;
    }

    .form-card hr {
        border-color: #4A5568; /* Màu đường kẻ ngang */
        margin-bottom: 30px;
    }

    /* Validation Summary */
    .validation-summary-errors {
        color: #EF4444; /* Màu đỏ cho lỗi */
        background-color: rgba(239, 68, 68, 0.1);
        border: 1px solid #EF4444;
        border-radius: 8px;
        padding: 15px;
        margin-bottom: 20px;
        font-size: 0.9rem;
        text-align: center;
    }

    /* Form Layout (Grid) */
    .form-horizontal {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); /* 2 cột trên desktop, 1 cột trên mobile */
        gap: 25px 30px; /* Khoảng cách giữa các hàng và cột */
    }

    .form-group {
        display: flex;
        flex-direction: column;
        gap: 8px; /* Khoảng cách giữa label và input */
    }

    /* Labels */
    .control-label {
        font-size: 0.95rem;
        font-weight: 600;
        color: #E2E8F0; /* Màu chữ sáng */
        margin-bottom: 0; /* Xóa margin mặc định */
    }

    .form-control {
        width: 100%;
        padding: 12px 15px;
        border: 1px solid #4A5568; /* Viền màu tối */
        border-radius: 8px;
        font-size: 1rem;
        background-color: #2D3748; /* Nền input tối */
        color: #ffffff; /* CHỮ TRONG INPUT MÀU TRẮNG TINH */
        /* Đã loại bỏ transition để không có hiệu ứng khi focus */
    }

    /* Validation messages for individual fields */
    .text-danger {
        color: #EF4444; /* Màu đỏ cho lỗi */
        font-size: 0.8rem;
        margin-top: 4px;
        font-weight: 500;
    }

    /* File input specific styling */
    .form-control.file-input {
        padding: 8px 12px; /* Điều chỉnh padding cho input file */
        line-height: normal; /* Đảm bảo văn bản căn chỉnh đúng cách */
        cursor: pointer;
    }

    /* Image preview styling */
    .image-preview-group {
        grid-column: 1 / -1; /* Làm cho phần xem trước ảnh chiếm toàn bộ chiều rộng */
        text-align: center;
    }

    .image-preview {
        max-width: 300px;
        max-height: 200px; /* Giới hạn chiều cao để hiển thị tốt hơn */
        border-radius: 8px;
        border: 1px solid #4A5568;
        margin-top: 10px;
        display: block; /* Hiển thị theo mặc định nếu có ảnh cũ */
        margin-left: auto;
        margin-right: auto;
        object-fit: contain; /* Đảm bảo ảnh được căn chỉnh đúng tỷ lệ mà không bị cắt */
    }

    /* Image path display */
    .image-path-display {
        display: block; /* Biến nó thành một phần tử khối */
        margin-top: 5px;
        font-size: 0.9rem;
        color: #E2E8F0; /* Màu mặc định */
    }

    /* Submit button group */
    .form-group.submit-group {
        grid-column: 1 / -1; /* Chiếm toàn bộ chiều rộng hàng */
        display: flex;
        justify-content: center; /* Căn giữa nút */
        margin-top: 30px;
        gap: 15px; /* Khoảng cách giữa các nút */
    }

    .btn-submit {
        padding: 14px 30px;
        background: linear-gradient(45deg, #4FD1C5, #38B2AC); /* Gradient màu nhấn */
        border: none;
        color: #1A202C; /* Chữ tối trên nền sáng */
        font-size: 1.1rem;
        font-weight: 700;
        border-radius: 10px;
        cursor: pointer;
        transition: all 0.3s ease;
        box-shadow: 0 4px 15px rgba(79, 209, 197, 0.3);
    }

    .btn-submit:hover {
        background: linear-gradient(45deg, #38B2AC, #4FD1C5);
        transform: translateY(-3px);
        box-shadow: 0 6px 20px rgba(79, 209, 197, 0.4);
    }

    .btn-submit:active {
        transform: translateY(0);
        box-shadow: 0 2px 10px rgba(79, 209, 197, 0.2);
    }

    /* Back to List link */
    .back-link-container {
        text-align: center;
        margin-top: 25px;
    }

    .back-link {
        padding: 14px 30px; /* Thêm padding cho link để trông giống nút */
        background: linear-gradient(45deg, #63B3ED, #4299E1); /* Màu xanh dương cho link */
        border: none;
        color: #FFFFFF; /* Chữ trắng */
        font-size: 1.1rem;
        font-weight: 700;
        border-radius: 10px;
        cursor: pointer;
        transition: all 0.3s ease;
        box-shadow: 0 4px 15px rgba(99, 179, 237, 0.3);
        text-decoration: none; /* Bỏ gạch chân mặc định */
        display: inline-block; /* Để padding và margin hoạt động */
    }

    .back-link:hover {
        background: linear-gradient(45deg, #4299E1, #63B3ED);
        transform: translateY(-3px);
        box-shadow: 0 6px 20px rgba(99, 179, 237, 0.4);
    }

    .back-link:active {
        transform: translateY(0);
        box-shadow: 0 2px 10px rgba(99, 179, 237, 0.2);
    }

    /* Responsive adjustments */
    @@media (max-width: 768px) {
        .form-card {
            padding: 30px;
            border-radius: 8px;
        }

        .form-card h2 {
            font-size: 1.8rem;
            margin-bottom: 20px;
        }

        .form-horizontal {
            grid-template-columns: 1fr; /* Một cột trên mobile */
            gap: 20px;
        }

        .form-control {
            padding: 10px 12px;
            font-size: 0.95rem;
        }

        .btn-submit, .back-link {
            padding: 12px 25px;
            font-size: 1rem;
            width: 100%; /* Nút chiếm toàn bộ chiều rộng trên mobile */
        }
        .form-group.submit-group {
            flex-direction: column; /* Xếp nút dọc trên mobile */
        }
    }

    @@media (max-width: 480px) {
        .form-card {
            padding: 20px;
        }

        .form-card h2 {
            font-size: 1.5rem;
        }
    }
</style>

<div class="edit-book-container-wrapper">
    <div class="form-card">
        <h2>CHỈNH SỬA SÁCH</h2>

        @using (Html.BeginForm("QTV_QLSP_SuaSach", "QTV_QLSP", FormMethod.Post, new { enctype = "multipart/form-data" }))
        {
            @Html.AntiForgeryToken() @Html.HiddenFor(model => model.MaSach) <div class="form-horizontal">
    
        @Html.ValidationSummary(true, "", new { @class = "validation-summary-errors" })

        <div class="form-group">
            <label class="control-label">Tên Sách</label>
            @Html.TextBoxFor(model => model.TenSach, new { @class = "form-control", placeholder = "Nhập tên sách" })
            @Html.ValidationMessageFor(model => model.TenSach, "", new { @class = "text-danger" })
        </div>

        <div class="form-group">
            <label class="control-label">Tác Giả</label>
            @Html.TextBoxFor(model => model.TacGia, new { @class = "form-control", placeholder = "Nhập tên tác giả" })
            @Html.ValidationMessageFor(model => model.TacGia, "", new { @class = "text-danger" })
        </div>

        <div class="form-group">
            <label class="control-label">Nhà Xuất Bản</label>
            @Html.TextBoxFor(model => model.NhaXuatBan, new { @class = "form-control", placeholder = "Nhập nhà xuất bản" })
            @Html.ValidationMessageFor(model => model.NhaXuatBan, "", new { @class = "text-danger" })
        </div>

        <div class="form-group">
            <label class="control-label">Năm Xuất Bản</label>
            @Html.TextBoxFor(model => model.NamXuatBan, new { @class = "form-control", placeholder = "Nhập năm xuất bản", type = "number" })
            @Html.ValidationMessageFor(model => model.NamXuatBan, "", new { @class = "text-danger" })
        </div>

        <div class="form-group">
            <label class="control-label">Giá Bán</label>
            @Html.TextBoxFor(model => model.Gia, new { @class = "form-control", placeholder = "Nhập giá bán", type = "number", step = "0.01" })
            @Html.ValidationMessageFor(model => model.Gia, "", new { @class = "text-danger" })
        </div>

        <div class="form-group">
            <label class="control-label">Số Lượng Tồn Kho</label>
            @Html.TextBoxFor(model => model.SoLuongTon, new { @class = "form-control", placeholder = "Nhập số lượng tồn kho", type = "number" })
            @Html.ValidationMessageFor(model => model.SoLuongTon, "", new { @class = "text-danger" })
        </div>

        <div class="form-group">
            <label class="control-label">Thể Loại Sách</label>
            @Html.DropDownListFor(
                model => model.MaTheLoai,
                (SelectList)ViewBag.TheLoaiList,
                "Chọn thể loại",
                new { @class = "form-control" })
            @Html.ValidationMessageFor(model => model.MaTheLoai, "", new { @class = "text-danger" })
        </div>

        <div class="form-group">
            <label class="control-label">Mô Tả</label>
            @Html.TextAreaFor(model => model.MoTa, new { @class = "form-control", placeholder = "Nhập mô tả", rows = 3 })
            @Html.ValidationMessageFor(model => model.MoTa, "", new { @class = "text-danger" })
        </div>
        <div class="form-group">
            <div class="form-group image-preview-group">
                <label for="currentImage">Ảnh Bìa Hiện Tại</label><br />
                <img id="currentImage" src="@Url.Content("~/images/" + Model.UrlanhBia)" onerror="this.onerror=null;this.src='https://placehold.co/300x200/2D3748/E2E8F0?text=No+Image';" alt="Ảnh Bìa Hiện Tại" class="image-preview" />
            </div>

            <div class="form-group">
                <label class="control-label">Chọn Ảnh Bìa Mới</label>
                <input type="file" id="fileUpload" name="imageFile" class="form-control file-input" onchange="previewImage()" />
            </div>

            <div class="form-group image-preview-group">
                <label for="newImage">Ảnh Mới Đã Chọn</label><br />
                <img id="newImage" src="" alt="Ảnh Mới Đã Chọn" class="image-preview" style="display:none;" />
            </div>

            <div class="form-group">
                <label for="imagePath">Đường Dẫn Ảnh Mới</label><br />
                <span id="imagePath" class="image-path-display">Chưa chọn ảnh</span>
            </div>
        </div>
        <div class="form-group submit-group">
            <input type="submit" value="Lưu Thay Đổi" class="btn-submit" />
            @Html.ActionLink("Quay lại", "QuanLySanPham_QuanTriVien", "QuanTriVien", null, new { @class = "back-link",
           style = "display: inline-block; text-align: center;" })
        </div>
    </div>
        }
    </div>
</div>

<script>
    // Hàm hiển thị ảnh mới sau khi chọn
    function previewImage() {
        var fileInput = document.getElementById("fileUpload");
        var file = fileInput.files[0];
        var reader = new FileReader();
        var imagePathSpan = document.getElementById("imagePath");
        var newImage = document.getElementById("newImage");

        // Reset previous state for new image preview
        newImage.style.display = "none";
        newImage.src = "";
        imagePathSpan.textContent = "Chưa chọn ảnh";
        imagePathSpan.style.color = "#E2E8F0"; // Reset color

        // Kiểm tra xem có file nào được chọn không
        if (file) {
            // Kiểm tra loại tệp
            var allowedTypes = ['image/jpeg', 'image/png', 'image/gif', 'image/jpg'];
            if (allowedTypes.includes(file.type)) {
                reader.onloadend = function () {
                    imagePathSpan.textContent = file.name; // Hiển thị tên file ảnh đã chọn
                    newImage.src = reader.result; // Đặt nguồn ảnh cho thẻ img
                    newImage.style.display = "block"; // Hiển thị ảnh mới
                };
                reader.readAsDataURL(file); // Đọc ảnh dưới dạng DataURL
            } else {
                // Thông báo lỗi nếu không phải ảnh
                imagePathSpan.textContent = "Vui lòng chọn tệp ảnh có định dạng hợp lệ (jpg, jpeg, png, gif).";
                imagePathSpan.style.color = "#EF4444"; // Highlight error
                fileInput.value = ''; // Clear the file input
            }
        }
    }

    // Đã loại bỏ hàm confirm() theo yêu cầu. Form sẽ submit trực tiếp.
    // Loại bỏ event listener cho submitBtn vì không còn confirm()
    // document.getElementById("submitBtn").addEventListener("click", function (event) {
    //     // Logic confirm đã bị loại bỏ
    // });
</script>

@section Scripts {
    <script src="~/scripts/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/scripts/jquery.validate.unobtrusive.js"></script>
    <script src="~/scripts/jquery.validate-vsdoc.js"></script>
    <script src="~/scripts/jquery.validate.min.js"></script>
    <script src="~/scripts/jquery.validate.js"></script>
}

