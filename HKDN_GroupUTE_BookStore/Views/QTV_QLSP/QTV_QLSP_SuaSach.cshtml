@model HKDN_GroupUTE_BookStore.Models.Sach

@{
    ViewBag.Title = "Edit";
    Layout = "~/Views/Shared/_LayoutQuanTriVien.cshtml";
}

<style>
    /* Container chính cho toàn bộ nội dung */
    .edit-book-container-wrapper {
        display: flex;
        justify-content: center;
        align-items: flex-start;
        padding: 40px 20px;
        min-height: calc(100vh - 56px);
        background-color: #1A202C;
        color: #E2E8F0;
    }

    /* Card chứa form */
    .form-card {
        background-color: #2D3748;
        padding: 40px;
        border-radius: 12px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.25);
        width: 100%;
        max-width: 1100px; /* Tăng chiều rộng max để chứa 2 cột thoải mái */
        transition: transform 0.3s ease-in-out;
    }

        /* Tiêu đề trang */
        .form-card h2 {
            text-align: center;
            font-size: 2.2rem;
            font-weight: 700;
            color: #4FD1C5;
            margin-bottom: 25px;
            text-transform: uppercase;
            letter-spacing: 1.5px;
        }

    /* Validation Summary */
    .validation-summary-errors {
        color: #EF4444;
        background-color: rgba(239, 68, 68, 0.1);
        border: 1px solid #EF4444;
        border-radius: 8px;
        padding: 15px;
        margin-bottom: 20px;
        font-size: 0.9rem;
        text-align: center;
    }

    /* --- LAYOUT 2 CỘT MỚI --- */
    .edit-layout-grid {
        display: grid;
        grid-template-columns: 320px 1fr; /* Cột trái cố định 320px, cột phải tự giãn */
        gap: 40px; /* Khoảng cách giữa 2 cột */
        align-items: start;
    }

    /* Cột trái: Chứa ảnh */
    .col-left-images {
        display: flex;
        flex-direction: column;
        gap: 20px;
        background: rgba(0, 0, 0, 0.2); /* Nền tối nhẹ để làm nổi bật khu vực ảnh */
        padding: 20px;
        border-radius: 8px;
        border: 1px dashed #4A5568;
    }

    /* Cột phải: Grid inputs cũ */
    .col-right-info {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); /* Giữ layout grid cũ cho các input */
        gap: 25px 30px;
    }

    .form-group {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    /* Labels & Inputs */
    .control-label {
        font-size: 0.95rem;
        font-weight: 600;
        color: #E2E8F0;
        margin-bottom: 0;
    }

    .form-control {
        width: 100%;
        padding: 12px 15px;
        border: 1px solid #4A5568;
        border-radius: 8px;
        font-size: 1rem;
        background-color: #2D3748;
        color: #ffffff;
    }

    .text-danger {
        color: #EF4444;
        font-size: 0.8rem;
        margin-top: 4px;
        font-weight: 500;
    }

    /* File input specific styling */
    .form-control.file-input {
        padding: 8px 12px;
        line-height: normal;
        cursor: pointer;
    }

    /* Image preview styling */
    .image-preview {
        width: 100%;
        max-width: 100%; /* Đảm bảo ảnh không tràn ra khỏi cột trái */
        height: auto;
        max-height: 350px;
        border-radius: 8px;
        border: 1px solid #4A5568;
        display: block;
        object-fit: contain;
        background-color: #1A202C;
    }

    /* Image path display */
    .image-path-display {
        display: block;
        margin-top: 5px;
        font-size: 0.9rem;
        color: #E2E8F0;
        word-break: break-all; /* Ngắt dòng nếu tên file quá dài */
    }

    /* Submit button group */
    .form-group.submit-group {
        grid-column: 1 / -1; /* Chiếm toàn bộ chiều rộng */
        display: flex;
        justify-content: center;
        margin-top: 40px;
        gap: 15px;
        padding-top: 20px;
        border-top: 1px solid #4A5568; /* Thêm đường kẻ ngăn cách nút */
    }

    .btn-submit {
        padding: 14px 30px;
        background: linear-gradient(45deg, #4FD1C5, #38B2AC);
        border: none;
        color: #1A202C;
        font-size: 1.1rem;
        font-weight: 700;
        border-radius: 10px;
        cursor: pointer;
        transition: all 0.3s ease;
        box-shadow: 0 4px 15px rgba(79, 209, 197, 0.3);
    }

        .btn-submit:hover {
            background: linear-gradient(45deg, #38B2AC, #4FD1C5);
            transform: translateY(-3px);
            box-shadow: 0 6px 20px rgba(79, 209, 197, 0.4);
        }

    .back-link {
        padding: 14px 30px;
        background: linear-gradient(45deg, #63B3ED, #4299E1);
        border: none;
        color: #FFFFFF;
        font-size: 1.1rem;
        font-weight: 700;
        border-radius: 10px;
        cursor: pointer;
        transition: all 0.3s ease;
        box-shadow: 0 4px 15px rgba(99, 179, 237, 0.3);
        text-decoration: none;
        display: inline-block;
        text-align: center;
    }

        .back-link:hover {
            background: linear-gradient(45deg, #4299E1, #63B3ED);
            transform: translateY(-3px);
            box-shadow: 0 6px 20px rgba(99, 179, 237, 0.4);
        }

    /* Responsive adjustments */
    @@media (max-width: 900px) {
        /* Khi màn hình nhỏ hơn 900px, chuyển về 1 cột */
        .edit-layout-grid

    {
        grid-template-columns: 1fr;
    }

    .col-left-images {
        max-width: 400px;
        margin: 0 auto; /* Căn giữa ảnh trên mobile */
        width: 100%;
    }

    }

    @@media (max-width: 480px) {
        .form-card

    {
        padding: 20px;
    }

    .form-card h2 {
        font-size: 1.5rem;
    }

    .col-right-info {
        grid-template-columns: 1fr;
    }

    .btn-submit, .back-link {
        width: 100%;
        margin-bottom: 10px;
    }

    .form-group.submit-group {
        flex-direction: column;
    }

    }
</style>

<div class="edit-book-container-wrapper">
    <div class="form-card">
        <h2>CHỈNH SỬA SÁCH</h2>

        @using (Html.BeginForm("QTV_QLSP_SuaSach", "QTV_QLSP", FormMethod.Post, new { enctype = "multipart/form-data" }))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(model => model.MaSach)

            @Html.ValidationSummary(true, "", new { @class = "validation-summary-errors" })

            <div class="edit-layout-grid">

                <div class="col-left-images">
                    <div class="form-group">
                        <label class="control-label">Ảnh Bìa Hiện Tại</label>
                        <img id="currentImage" src="@Url.Content("~/images/" + Model.UrlanhBia)"
                             onerror="this.onerror=null;this.src='https://placehold.co/300x200/2D3748/E2E8F0?text=No+Image';"
                             alt="Ảnh Bìa Hiện Tại" class="image-preview" />
                    </div>

                    <div class="form-group">
                        <label class="control-label">Chọn Ảnh Bìa Mới</label>
                        <input type="file" id="fileUpload" name="imageFile" class="form-control file-input" onchange="previewImage()" />
                    </div>

                    <div class="form-group">
                        <label class="control-label" style="display:none;" id="lblNewImage">Ảnh Mới Đã Chọn</label>
                        <img id="newImage" src="" alt="Ảnh Mới Đã Chọn" class="image-preview" style="display:none;" />
                        <span id="imagePath" class="image-path-display">Chưa chọn ảnh mới</span>
                    </div>
                </div>

                <div class="col-right-info">
                    <div class="form-group">
                        <label class="control-label">Tên Sách</label>
                        @Html.TextBoxFor(model => model.TenSach, new { @class = "form-control", placeholder = "Nhập tên sách" })
                        @Html.ValidationMessageFor(model => model.TenSach, "", new { @class = "text-danger" })
                    </div>

                    <div class="form-group">
                        <label class="control-label">Tác Giả</label>
                        @Html.TextBoxFor(model => model.TacGia, new { @class = "form-control", placeholder = "Nhập tên tác giả" })
                        @Html.ValidationMessageFor(model => model.TacGia, "", new { @class = "text-danger" })
                    </div>

                    <div class="form-group">
                        <label class="control-label">Nhà Xuất Bản</label>
                        @Html.TextBoxFor(model => model.NhaXuatBan, new { @class = "form-control", placeholder = "Nhập nhà xuất bản" })
                        @Html.ValidationMessageFor(model => model.NhaXuatBan, "", new { @class = "text-danger" })
                    </div>

                    <div class="form-group">
                        <label class="control-label">Năm Xuất Bản</label>
                        @Html.TextBoxFor(model => model.NamXuatBan, new { @class = "form-control", placeholder = "Nhập năm xuất bản", type = "number" })
                        @Html.ValidationMessageFor(model => model.NamXuatBan, "", new { @class = "text-danger" })
                    </div>

                    <div class="form-group">
                        <label class="control-label">Giá Bán</label>
                        @Html.TextBoxFor(model => model.Gia, new { @class = "form-control", placeholder = "Nhập giá bán", type = "number", step = "0.01" })
                        @Html.ValidationMessageFor(model => model.Gia, "", new { @class = "text-danger" })
                    </div>

                    <div class="form-group">
                        <label class="control-label">Số Lượng Tồn Kho</label>
                        @Html.TextBoxFor(model => model.SoLuongTon, new { @class = "form-control", placeholder = "Nhập số lượng tồn kho", type = "number" })
                        @Html.ValidationMessageFor(model => model.SoLuongTon, "", new { @class = "text-danger" })
                    </div>

                    <div class="form-group">
                        <label class="control-label">Thể Loại Sách</label>
                        @Html.DropDownListFor(
                        model => model.MaTheLoai,
                                        (SelectList)ViewBag.TheLoaiList,
                                        "Chọn thể loại",
                                        new { @class = "form-control" })
                    @Html.ValidationMessageFor(model => model.MaTheLoai, "", new { @class = "text-danger" })
                </div>

                <div class="form-group" style="grid-column: 1 / -1;">
                    <label class="control-label">Mô Tả</label>
                    @Html.TextAreaFor(model => model.MoTa, new { @class = "form-control", placeholder = "Nhập mô tả", rows = 4 })
                    @Html.ValidationMessageFor(model => model.MoTa, "", new { @class = "text-danger" })
                </div>
            </div>
        </div>

        <div class="form-group submit-group">
            <input type="submit" value="Lưu Thay Đổi" class="btn-submit" />
            @Html.ActionLink("Quay lại", "QuanLySanPham_QuanTriVien", "QuanTriVien", null, new { @class = "back-link" })
        </div>
                }
    </div>
</div>

<script>
    // Hàm hiển thị ảnh mới sau khi chọn
    function previewImage() {
        var fileInput = document.getElementById("fileUpload");
        var file = fileInput.files[0];
        var reader = new FileReader();
        var imagePathSpan = document.getElementById("imagePath");
        var newImage = document.getElementById("newImage");
        var lblNewImage = document.getElementById("lblNewImage");

        // Reset previous state for new image preview
        newImage.style.display = "none";
        lblNewImage.style.display = "none";
        newImage.src = "";
        imagePathSpan.textContent = "Chưa chọn ảnh mới";
        imagePathSpan.style.color = "#E2E8F0"; // Reset color

        // Kiểm tra xem có file nào được chọn không
        if (file) {
            // Kiểm tra loại tệp
            var allowedTypes = ['image/jpeg', 'image/png', 'image/gif', 'image/jpg'];
            if (allowedTypes.includes(file.type)) {
                reader.onloadend = function () {
                    imagePathSpan.textContent = file.name; // Hiển thị tên file ảnh đã chọn
                    newImage.src = reader.result; // Đặt nguồn ảnh cho thẻ img
                    newImage.style.display = "block"; // Hiển thị ảnh mới
                    lblNewImage.style.display = "block";
                };
                reader.readAsDataURL(file); // Đọc ảnh dưới dạng DataURL
            } else {
                // Thông báo lỗi nếu không phải ảnh
                imagePathSpan.textContent = "Vui lòng chọn tệp ảnh có định dạng hợp lệ (jpg, jpeg, png, gif).";
                imagePathSpan.style.color = "#EF4444"; // Highlight error
                fileInput.value = ''; // Clear the file input
            }
        }
    }
</script>

@section Scripts {
    <script src="~/scripts/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/scripts/jquery.validate.unobtrusive.js"></script>
    <script src="~/scripts/jquery.validate-vsdoc.js"></script>
    <script src="~/scripts/jquery.validate.min.js"></script>
    <script src="~/scripts/jquery.validate.js"></script>
}