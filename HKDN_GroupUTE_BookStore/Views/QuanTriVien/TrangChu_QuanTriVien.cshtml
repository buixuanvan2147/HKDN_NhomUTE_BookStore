@model HKDN_GroupUTE_BookStore.ViewModel.QTV_TrangChu_LoadDuLieu_VM
@{
    ViewBag.Title = "TrangChu_QuanTriVien";
    Layout = "~/Views/Shared/_LayoutQuanTriVien.cshtml";
}

<style>
    /* Wrapper class để scope CSS cho view này */
    .view-trangchu {
        max-width: none;
        margin: 0 auto;
        padding: 2rem 1.5rem;
        background-color: #1A202C;
        min-height: calc(100vh - 4rem);
        display: flex;
        flex-direction: column;
        gap: 2rem;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

        .view-trangchu .dashboard-header {
            padding-bottom: 1rem;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        }

        .view-trangchu .dashboard-title {
            font-size: 2.25rem;
            font-weight: 700;
            color: #ffffff;
            margin-bottom: 0.5rem;
            text-shadow: 0 1px 2px rgba(0, 0, 0, 0.2);
        }

        .view-trangchu .dashboard-subtitle {
            color: rgba(255, 255, 255, 0.7);
            font-size: 1rem;
            font-weight: 400;
        }

        /* --- STATS GRID (3 Thẻ to) --- */
        .view-trangchu .stats-grid {
            display: flex;
            flex-wrap: wrap;
            gap: 1.5rem;
            justify-content: space-between;
        }

        .view-trangchu .stat-card {
            background: #2D3748;
            border-radius: 1rem;
            padding: 1.5rem;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
            transition: all 0.3s ease;
            flex: 1;
            min-width: 280px;
            border: 1px solid #4A5568;
        }

            .view-trangchu .stat-card:hover {
                transform: translateY(-5px);
                box-shadow: 0 10px 15px rgba(0, 0, 0, 0.2);
                background: linear-gradient(135deg, #2D3748, #3b4a66);
            }

        .view-trangchu .stat-header {
            display: flex;
            align-items: center;
            margin-bottom: 1rem;
        }

        .view-trangchu .stat-icon {
            width: 3rem;
            height: 3rem;
            border-radius: 0.75rem;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-right: 1rem;
        }

            .view-trangchu .stat-icon i, .view-trangchu .stat-icon svg {
                font-size: 1.5rem;
                color: white;
            }

        .view-trangchu .icon-primary {
            background-color: #3182CE;
        }

        .view-trangchu .icon-success {
            background-color: #38A169;
        }

        .view-trangchu .icon-warning {
            background-color: #D69E2E;
        }

        .view-trangchu .stat-title {
            color: #EDF2F7;
            font-size: 0.9rem;
            font-weight: 600;
            text-transform: uppercase;
        }

        .view-trangchu .stat-value {
            font-size: 2rem;
            font-weight: 700;
            color: #EDF2F7;
            margin-bottom: 0.5rem;
        }

        .view-trangchu .stat-description {
            color: #EDF2F7;
            font-size: 0.85rem;
        }

        /* --- ORDERS SECTION & STATUS GRID (5 Thẻ nhỏ) --- */
        .view-trangchu .orders-section {
            background: #2D3748;
            border-radius: 1rem;
            padding: 1.5rem;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        }

        .view-trangchu .section-header {
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
            padding-bottom: 1rem;
            margin-bottom: 1.5rem;
        }

        .view-trangchu .section-title {
            font-size: 1.5rem;
            font-weight: 600;
            color: #E2E8F0;
        }

        .view-trangchu .status-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
            gap: 1.5rem;
            margin-bottom: 2.5rem;
        }

        .view-trangchu .status-card {
            background: #1A202C;
            border-radius: 0.75rem;
            padding: 1rem;
            text-align: center;
            transition: all 0.3s ease;
            border: 1px solid #4A5568;
            position: relative;
            overflow: hidden;
        }

            .view-trangchu .status-card:hover {
                transform: translateY(-3px);
                background-color: #232d3f;
            }

        .view-trangchu .status-value {
            font-size: 1.8rem;
            font-weight: 700;
            margin-bottom: 0.25rem;
        }

        .view-trangchu .status-label {
            color: #EDF2F7;
            font-size: 0.9rem;
            font-weight: 500;
            text-transform: uppercase;
        }

        /* --- CHARTS LAYOUT --- */
        .view-trangchu .charts-row {
            display: flex;
            gap: 1.5rem;
            margin-top: 1.5rem;
        }

        .view-trangchu .chart-half {
            flex: 1;
            min-width: 0;
        }

        .view-trangchu .chart-full {
            width: 100%;
            margin-top: 2rem;
        }

        .view-trangchu .chart-container {
            background: rgba(26, 32, 44, 0.6);
            border: 1px solid #4A5568;
            border-radius: 1rem;
            padding: 1.5rem;
            height: 350px;
            position: relative;
        }

        .view-trangchu .card-title {
            font-size: 1.1rem;
            font-weight: 600;
            margin-bottom: 1rem;
            text-align: center;
        }

    /* Responsive */
    @@media (max-width: 992px) {
        .view-trangchu .charts-row

    {
        flex-direction: column;
    }

    }
    @@media (max-width: 768px) {
        .view-trangchu

    {
        padding: 1rem;
    }

    .view-trangchu .dashboard-title {
        font-size: 1.8rem;
    }

    .view-trangchu .status-grid {
        grid-template-columns: repeat(2, 1fr);
    }

    }
</style>

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />

<div class="view-trangchu">
    <header class="dashboard-header">
        <h1 class="dashboard-title">Tổng quan hệ thống</h1>
        <p class="dashboard-subtitle">Cập nhật lúc @DateTime.Now.ToString("HH:mm - dddd, dd/MM/yyyy")</p>
    </header>

    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-header">
                <div class="stat-icon icon-primary">
                    <i class="fas fa-users"></i>
                </div>
                <div class="stat-title">Tổng người dùng</div>
            </div>
            <div class="stat-value">@Model.TongSoNguoiDung</div>
            <div class="stat-description">
                Khách: @Model.TongSoKhachHang | Admin: @Model.TongSoQuanTriVien
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-header">
                <div class="stat-icon icon-success">
                    <i class="fas fa-shopping-bag"></i>
                </div>
                <div class="stat-title">Tổng đơn hàng</div>
            </div>
            <div class="stat-value">@Model.TongDonHang</div>
            <div class="stat-description">
                Doanh thu dự kiến tăng trưởng tốt
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-header">
                <div class="stat-icon icon-warning">
                    <i class="fas fa-book"></i>
                </div>
                <div class="stat-title">Kho sách</div>
            </div>
            <div class="stat-value">@Model.TongSach</div>
            <div class="stat-description">
                Tồn: @Model.TongSachTonKho | Đã bán: @Model.TongSachDaBan
            </div>
        </div>
    </div>

    <div class="orders-section">
        <div class="section-header">
            <h2 class="section-title">Chi tiết trạng thái đơn hàng</h2>
        </div>

        <div class="status-grid">
            <div class="status-card" style="border-bottom: 4px solid #ECC94B;">
                <div class="status-value" style="color: #ECC94B;">@Model.SlChoXacNhan</div>
                <div class="status-label">Chờ xác nhận</div>
            </div>

            <div class="status-card" style="border-bottom: 4px solid #4FD1C5;">
                <div class="status-value" style="color: #4FD1C5;">@Model.SlDangXuLy</div>
                <div class="status-label">Đang xử lý</div>
            </div>

            <div class="status-card" style="border-bottom: 4px solid #805AD5;">
                <div class="status-value" style="color: #805AD5;">@Model.SlDangGiao</div>
                <div class="status-label">Đang giao</div>
            </div>

            <div class="status-card" style="border-bottom: 4px solid #48BB78;">
                <div class="status-value" style="color: #48BB78;">@Model.SlDaGiao</div>
                <div class="status-label">Đã giao</div>
            </div>

            <div class="status-card" style="border-bottom: 4px solid #F56565;">
                <div class="status-value" style="color: #F56565;">@Model.SlDaHuy</div>
                <div class="status-label">Đã hủy</div>
            </div>
        </div>

        <div class="charts-row">
            <div class="chart-half">
                <div class="chart-container">
                    <h3 class="card-title" style="color: #63B3ED;">📉 Xu hướng theo tháng</h3>
                    <canvas id="lineChartMulti"></canvas>
                </div>
            </div>

            <div class="chart-half">
                <div class="chart-container">
                    <h3 class="card-title" style="color: #F6AD55;">🥧 Tỷ lệ trạng thái hiện tại</h3>
                    <canvas id="doughnutChart"></canvas>
                </div>
            </div>
        </div>

        <div class="chart-full">
            <div class="chart-container" style="height: 400px;">
                <h3 class="card-title" style="color: #48BB78;">💰 Doanh thu thực tế (Đã giao thành công)</h3>
                <canvas id="revenueChart"></canvas>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // === 1. LẤY DỮ LIỆU TỪ C# ===
        const labels = @Html.Raw(Json.Serialize(Model.Thang));

        // Dữ liệu biểu đồ đường (History)
        const dChoXacNhan = @Html.Raw(Json.Serialize(Model.DonChoXacNhan));
        const dDangXuLy   = @Html.Raw(Json.Serialize(Model.DonDangXuLy));
        const dDangGiao   = @Html.Raw(Json.Serialize(Model.DonDangGiao));
        const dDaGiao     = @Html.Raw(Json.Serialize(Model.DonDaGiao));
        const dDaHuy      = @Html.Raw(Json.Serialize(Model.DonDaHuy));
        const dDoanhThu   = @Html.Raw(Json.Serialize(Model.DoanhThuTheoThang));

        // Dữ liệu biểu đồ tròn (Snapshot hiện tại - lấy từ số liệu Card)
        const snapshotData = [
            @Model.SlChoXacNhan,
            @Model.SlDangXuLy,
            @Model.SlDangGiao,
            @Model.SlDaGiao,
            @Model.SlDaHuy
        ];

        // === 2. CẤU HÌNH MÀU SẮC CHUẨN ===
        const colors = {
            yellow: '#ECC94B',
            teal:   '#4FD1C5',
            purple: '#805AD5',
            green:  '#48BB78',
            red:    '#F56565'
        };

        // --- CHART 1: LINE CHART (5 TRẠNG THÁI) ---
        const ctxLine = document.getElementById('lineChartMulti').getContext('2d');
        new Chart(ctxLine, {
            type: 'line',
            data: {
                labels: labels,
                datasets: [
                    {
                        label: 'Chờ xác nhận',
                        data: dChoXacNhan,
                        borderColor: colors.yellow,
                        backgroundColor: colors.yellow,
                        tension: 0.3,
                        borderWidth: 2,
                        pointRadius: 3
                    },
                    {
                        label: 'Đang xử lý',
                        data: dDangXuLy,
                        borderColor: colors.teal,
                        backgroundColor: colors.teal,
                        tension: 0.3,
                        borderWidth: 2,
                        pointRadius: 3
                    },
                    {
                        label: 'Đang giao',
                        data: dDangGiao,
                        borderColor: colors.purple,
                        backgroundColor: colors.purple,
                        tension: 0.3,
                        borderWidth: 2,
                        pointRadius: 3
                    },
                    {
                        label: 'Đã giao',
                        data: dDaGiao,
                        borderColor: colors.green,
                        backgroundColor: colors.green,
                        tension: 0.3,
                        borderWidth: 2,
                        pointRadius: 3
                    },
                    {
                        label: 'Đã hủy',
                        data: dDaHuy,
                        borderColor: colors.red,
                        backgroundColor: colors.red,
                        tension: 0.3,
                        borderWidth: 2,
                        pointRadius: 3
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                layout: {
                    padding: 40
                },
                plugins: {
                    legend: { labels: { color: '#EDF2F7', usePointStyle: true } }
                },
                scales: {
                    x: { ticks: { color: '#EDF2F7' }, grid: { color: 'rgba(255,255,255,0.05)' } },
                    y: { ticks: { color: '#EDF2F7' }, grid: { color: 'rgba(255,255,255,0.05)' } }
                }
            }
        });

        // --- CHART 2: DOUGHNUT CHART (TỈ LỆ HIỆN TẠI) ---
        const ctxPie = document.getElementById('doughnutChart').getContext('2d');
        new Chart(ctxPie, {
            type: 'doughnut',
            data: {
                labels: ['Chờ xác nhận', 'Đang xử lý', 'Đang giao', 'Đã giao', 'Đã hủy'],
                datasets: [{
                    data: snapshotData,
                    backgroundColor: [colors.yellow, colors.teal, colors.purple, colors.green, colors.red],
                    borderWidth: 0,
                    hoverOffset: 10
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                layout: {
                    padding: 40 
                },
                plugins: {
                    legend: {
                        position: 'right',
                        labels: { color: '#E2E8F0', padding: 15, usePointStyle: true }
                    }
                },
                cutout: '70%'
            }
        });

        // --- CHART 3: BAR CHART (DOANH THU) ---
        const ctxRev = document.getElementById('revenueChart').getContext('2d');
        // Tạo gradient xanh dương đẹp
        const gradRev = ctxRev.createLinearGradient(0, 0, 0, 400);
        gradRev.addColorStop(0, '#63B3ED');
        gradRev.addColorStop(1, '#3182CE');

        new Chart(ctxRev, {
            type: 'bar',
            data: {
                labels: labels,
                datasets: [{
                    label: 'Doanh thu (VNĐ)',
                    data: dDoanhThu,
                    backgroundColor: gradRev,
                    borderRadius: 6,
                    barPercentage: 0.6
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                layout: {
                    padding: 40
                },
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        callbacks: {
                            label: function(c) {
                                return c.parsed.y.toLocaleString('vi-VN') + ' VNĐ';
                            }
                        }
                    }
                },
                scales: {
                    x: { ticks: { color: '#EDF2F7' }, grid: { display: false } },
                    y: {
                        ticks: {
                            color: '#EDF2F7',
                            callback: function(v) { return v.toLocaleString('vi-VN'); }
                        },
                        grid: { color: 'rgba(255,255,255,0.05)' }
                    }
                }
            }
        });
    </script>
}